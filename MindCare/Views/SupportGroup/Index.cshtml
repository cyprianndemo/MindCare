@model IEnumerable<SupportGroup>
@{
    ViewData["Title"] = "Support Groups";
}

<div class="container">
    <h2>Support Groups</h2>
    <div class="row">
        @foreach (var group in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@group.Name</h5>
                        <p class="card-text">@group.Description</p>
                        <a asp-action="Chat" asp-route-groupId="@group.Id"
                           class="btn btn-primary">Join Chat</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>