@model IEnumerable<MindCare.Models.MoodAnalytics>
@{
    ViewData["Title"] = "Mood Analytics";
}

<div class="container my-5">
    <h1 class="text-primary mb-4">Mood Analytics</h1>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h3 class="card-title mb-0">Mood Distribution</h3>
                </div>
                <div class="card-body">
                    <canvas id="moodPieChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h3 class="card-title mb-0">Average Intensity by Mood</h3>
                </div>
                <div class="card-body">
                    <canvas id="intensityBarChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Prepare data for charts
        const moodData = @Html.Raw(Json.Serialize(Model));
        const labels = moodData.map(x => x.mood);
        const counts = moodData.map(x => x.count);
        const averageIntensities = moodData.map(x => x.averageIntensity);
        
        // Colors for charts
        const colors = [
            '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF',
            '#FF9F40', '#FF6384', '#4BC0C0', '#FFCD56', '#36A2EB'
        ];

        // Create pie chart
        new Chart(document.getElementById('moodPieChart'), {
            type: 'pie',
            data: {
                labels: labels,
                datasets: [{
                    data: counts,
                    backgroundColor: colors,
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'right',
                    },
                }
            }
        });

        // Create bar chart
        new Chart(document.getElementById('intensityBarChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Average Intensity',
                    data: averageIntensities,
                    backgroundColor: colors,
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 10
                    }
                }
            }
        });
    </script>
}