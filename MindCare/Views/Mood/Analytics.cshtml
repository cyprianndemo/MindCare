@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Mood Analytics";
}
<div class="container my-5">
    <h1 class="text-primary">Mood Analytics</h1>

    <canvas id="moodChart" class="mt-4"></canvas>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var ctx = document.getElementById('moodChart').getContext('2d');
        var moodData = @Html.Raw(Json.Serialize(Model));
        var labels = moodData.map(x => x.Mood);
        var data = moodData.map(x => x.Count);

        var chart = new Chart(ctx, {
            type: 'pie', // Change to 'bar' for bar chart
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF'],
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'top',
                    },
                }
            }
        });
    </script>
</div>
