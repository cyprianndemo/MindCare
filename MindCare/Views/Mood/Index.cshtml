@model IEnumerable<MindCare.Models.MoodEntry>
@{
    ViewData["Title"] = "Mood History";
}
<div class="container my-5">
    <h1 class="text-primary">Mood History</h1>

    <table class="table table-striped mt-4">
        <thead>
            <tr>
                <th>Date</th>
                <th>Mood</th>
                <th>Intensity</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var mood in Model)
            {
                <tr>
                    <td>@mood.EntryDate.ToShortDateString()</td>
                    <td>@mood.Mood</td>
                    <td>@mood.Intensity</td>
                </tr>
            }
        </tbody>
    </table>

    <a href="@Url.Action("AddMood", "Mood")" class="btn" style="background-color: #004085; color: #fff;">Add New Mood</a>
    <a href="@Url.Action("Analytics", "Mood")" class="btn btn-success">View Analytics</a>
</div>
