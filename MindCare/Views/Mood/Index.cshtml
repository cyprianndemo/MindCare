@model IEnumerable<MindCare.Models.MoodEntry>

@{
    ViewData["Title"] = "Mood Tracker";
}

<div class="container">
    <h2>My Mood Entries</h2>
    <p>
        <a asp-action="Create" class="btn btn-primary">Add New Mood Entry</a>
    </p>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Mood</th>
                    <th>Intensity</th>
                    <th>Notes</th>
                    <th>Actions</th>
                    <th>Analytics</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EntryDate.ToString("MMM dd, yyyy HH:mm")</td>
                        <td>@item.Mood</td>
                        <td>@item.Intensity</td>
                        <td>@(item.Notes?.Length > 50 ? item.Notes.Substring(0, 47) + "..." : item.Notes)</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                        </td>
                        <td>
                            <a asp-action="Analytics" asp-route-id="@item.Id" class="btn btn-info btn-sm">Analytics</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>