@{

    ViewData
[
"Title"
]
 
=
 
"401 - Unauthorized"
;

}


<div class="container text-center py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-0 p-4">
                <div class="card-body">
                    <div class="display-1 text-danger mb-3">
                        <i class="bi bi-lock"></i>
                    </div>
                    <h1 class="display-2 fw-bold text-danger">401</h1>
                    <h2 class="fs-2 mb-3">Unauthorized</h2>
                    <p class="lead text-muted mb-4">
                        You don't have permission to access this page. Please log in or contact your administrator if you believe this is an error.
                    </p>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4 fw-medium">
                        Log In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}