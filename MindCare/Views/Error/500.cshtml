@{

    ViewData
[
"Title"
]
 
=
 
"500 - Internal Server Error"
;

}


<div class="container text-center py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-0 p-4">
                <div class="card-body">
                    <div class="display-1 text-danger mb-3">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <h1 class="display-2 fw-bold text-danger">500</h1>
                    <h2 class="fs-2 mb-3">Internal Server Error</h2>
                    <p class="lead text-muted mb-4">
                        Something went wrong on our end. Our team has been notified and we're working to fix the issue.
                    </p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4 fw-medium">
                        Return to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}