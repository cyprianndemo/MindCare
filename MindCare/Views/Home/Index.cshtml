@{
    ViewData["Title"] = "Welcome to MindCare System";
    Layout = "_Layout";
}

<style>
    /* Hero Section */
    .hero-section {
        background: linear-gradient(rgba(0, 64, 133, 0.8), rgba(0, 64, 133, 0.9)), url("/images/hero-bg.jpg") center/cover;
        min-height: 50vh;
        color: white;
        padding: 100px 0;
        position: relative;
    }

    /* Logo Styling */
    .logo-container {
        width: 100px;
        height: 10px;
        margin-bottom: 2rem;
    }

    /* Section Styling */
    .section-padding {
        padding: 80px 0;
    }

    .service-card {
        border: none;
        border-radius: 15px;
        transition: transform 0.3s ease;
        height: 100%;
    }

        .service-card:hover {
            transform: translateY(-10px);
        }

    .service-icon {
        font-size: 2.5rem;
        color: #004085;
        margin-bottom: 1rem;
    }

    /* Testimonial Section */
    .testimonial-card {
        background: #fff;
        border-radius: 15px;
        padding: 2rem;
        margin: 1rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .video-container {
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        overflow: hidden;
        border-radius: 10px;
    }

    /* Health Resources */
    .resource-card {
        border: none;
        border-radius: 15px;
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .resource-img {
        height: 200px;
        object-fit: cover;
    }

    /* Contact Section */
    .contact-info {
        background: #f8f9fa;
        padding: 2rem;
        border-radius: 15px;
    }

    /* Call to Action */
    .cta-section {
        background: linear-gradient(rgba(0, 64, 133, 0.9), rgba(0, 64, 133, 0.9)), url("/images/cta-bg.jpg") center/cover;
        color: white;
        padding: 60px 0;
    }

    /* Statistics */
    .stat-card {
        text-align: center;
        padding: 2rem;
        background: #fff;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .stat-number {
        font-size: 2.5rem;
        font-weight: bold;
        color: #004085;
    }
</style>

<!-- Hero Section -->
<section class="hero-section d-flex align-items-center text-center">
    <div class="container">
        <div class="logo-container mx-auto">
            <img src="/images/mindcare-logo.png" alt="MindCare Logo" class="img-fluid">
        </div>
        <h1 class="display-4 mb-4">Your Journey to Mental Wellness Begins Here</h1>
        <p class="lead mb-4">Professional support, resources, and a community that understands your mental health needs</p>
        <div class="d-flex justify-content-center gap-3">
            <a href="@Url.Action("BookAppointment", "Therapy")" class="btn btn-primary btn-lg">Book a Session</a>
            <a href="#learn-more" class="btn btn-outline-light btn-lg">Learn More</a>
        </div>
    </div>
</section>

<!-- Why Choose Us Section -->
<section id="learn-more" class="section-padding">
    <div class="container">
        <h2 class="text-center mb-5">Why Choose MindCare?</h2>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="stat-card">
                    <div class="stat-number">95%</div>
                    <p>Student Satisfaction Rate</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="stat-card">
                    <div class="stat-number">24/7</div>
                    <p>Support Available</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="stat-card">
                    <div class="stat-number">1000+</div>
                    <p>Students Helped</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Services Section -->
<section class="section-padding bg-light">
    <div class="container">
        <h2 class="text-center mb-5">Our Services</h2>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="service-card card">
                    <div class="card-body text-center">
                        <i class="fas fa-user-md service-icon"></i>
                        <h3>Individual Therapy</h3>
                        <p>One-on-one sessions with licensed therapists who understand student life.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="service-card card">
                    <div class="card-body text-center">
                        <i class="fas fa-users service-icon"></i>
                        <h3>Group Support</h3>
                        <p>Connect with peers facing similar challenges in a safe, moderated environment.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="service-card card">
                    <div class="card-body text-center">
                        <i class="fas fa-pills service-icon"></i>
                        <h3>Medication Management</h3>
                        <p>Professional psychiatric services and medication oversight when needed.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Mental Health Resources -->
<section class="section-padding">
    <div class="container">
        <h2 class="text-center mb-5">Mental Health Resources</h2>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="resource-card card">
                    <img src="/images/anxiety.jpg" class="resource-img" alt="Anxiety Support">
                    <div class="card-body">
                        <h3>Anxiety Management</h3>
                        <p>Learn effective techniques to manage anxiety and stress during academic life.</p>
                        <a href="#" class="btn btn-primary">Learn More</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="resource-card card">
                    <img src="/images/depression.jpg" class="resource-img" alt="Depression Support">
                    <div class="card-body">
                        <h3>Depression Support</h3>
                        <p>Understanding depression and finding ways to cope with its challenges.</p>
                        <a href="#" class="btn btn-primary">Learn More</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="resource-card card">
                    <img src="/images/stress.jpg" class="resource-img" alt="Stress Management">
                    <div class="card-body">
                        <h3>Stress Management</h3>
                        <p>Practical tools and techniques for managing academic and personal stress.</p>
                        <a href="#" class="btn btn-primary">Learn More</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials Section -->
<section class="section-padding bg-light">
    <div class="container">
        <h2 class="text-center mb-5">Student Success Stories</h2>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="testimonial-card">
                    <div class="video-container mb-3">
                        <img src="/images/testimonial1.jpg" alt="Student Testimonial" class="img-fluid">
                        <!-- Video embed would go here -->
                    </div>
                    <h4>Sarah's Journey</h4>
                    <p>"MindCare helped me manage my anxiety and improve my academic performance."</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="testimonial-card">
                    <div class="video-container mb-3">
                        <img src="/images/testimonial2.jpg" alt="Student Testimonial" class="img-fluid">
                        <!-- Video embed would go here -->
                    </div>
                    <h4>Michael's Story</h4>
                    <p>"The support I received helped me overcome depression and return to my studies."</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="testimonial-card">
                    <div class="video-container mb-3">
                        <img src="/images/testimonial3.jpg" alt="Student Testimonial" class="img-fluid">
                        <!-- Video embed would go here -->
                    </div>
                    <h4>Emma's Experience</h4>
                    <p>"Group therapy sessions helped me realize I wasn't alone in my struggles."</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Why Seek Help Section -->
<section class="section-padding">
    <div class="container">
        <h2 class="text-center mb-5">Why Seek Help?</h2>
        <div class="row align-items-center">
            <div class="col-md-6 mb-4">
                <img src="/images/seeking-help.jpg" alt="Seeking Help" class="img-fluid rounded">
            </div>
            <div class="col-md-6">
                <h3>It's Okay to Ask for Support</h3>
                <ul class="list-unstyled">
                    <li class="mb-3"><i class="fas fa-check text-primary mr-2"></i> Improve academic performance</li>
                    <li class="mb-3"><i class="fas fa-check text-primary mr-2"></i> Build better relationships</li>
                    <li class="mb-3"><i class="fas fa-check text-primary mr-2"></i> Develop coping strategies</li>
                    <li class="mb-3"><i class="fas fa-check text-primary mr-2"></i> Enhance self-awareness</li>
                    <li class="mb-3"><i class="fas fa-check text-primary mr-2"></i> Create work-life balance</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section class="section-padding bg-light">
    <div class="container">
        <h2 class="text-center mb-5">Contact Us</h2>
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="contact-info">
                    <h3>Get in Touch</h3>
                    <p><i class="fas fa-phone mr-2"></i> Emergency: 1-800-MINDCARE</p>
                    <p><i class="fas fa-envelope mr-2"></i> support@mindcare.com</p>
                    <p><i class="fas fa-map-marker-alt mr-2"></i> Student Center, Building 4</p>
                    <p><i class="fas fa-clock mr-2"></i> Available 24/7</p>
                </div>
            </div>
            <div class="col-md-6">
                <form>
                    <div class="mb-3">
                        <input type="text" class="form-control" placeholder="Your Name">
                    </div>
                    <div class="mb-3">
                        <input type="email" class="form-control" placeholder="Your Email">
                    </div>
                    <div class="mb-3">
                        <textarea class="form-control" rows="5" placeholder="Your Message"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Send Message</button>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="cta-section">
    <div class="container text-center">
        <h2 class="mb-4">Ready to Take the First Step?</h2>
        <p class="lead mb-4">Your mental health matters. Let us help you on your journey to wellness.</p>
        <a href="@Url.Action("BookAppointment", "Therapy")" class="btn btn-light btn-lg">Book Your First Session</a>
    </div>
</section>

@section Scripts {
    <script>
        // Animation for statistics
        document.addEventListener('DOMContentLoaded', function () {
            // Add scroll animations
            AOS.init();

            // Initialize testimonial carousel
            $('.testimonial-carousel').carousel({
                interval: 5000
            });
        });
    </script>
}