@model List<MindCare.ViewModel.PrescriptionViewModel>
@{
    ViewData["Title"] = "My Medications";
    Layout = "_StudentLayout"; // Make sure this is the correct layout for students
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header" style="background-color: #004085; color: #fff;">
            <h2 class="mb-0"><i class="fas fa-pills me-2"></i>My Medications</h2>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (Model.Count == 0)
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i> You don't have any prescribed medications at the moment.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Medication</th>
                                <th>Dosage</th>
                                <th>Frequency</th>
                                <th>Prescribed On</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prescription in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@prescription.MedicationName</td>
                                    <td>@prescription.Dosage</td>
                                    <td>@prescription.Frequency</td>
                                    <td>@prescription.PrescriptionDate.ToShortDateString()</td>
                                    <td>
                                        @if (prescription.Status == "Active")
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@prescription.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("StudentMedicationDetails", "Pharmacy", new { prescriptionId = prescription.PrescriptionId })"
                                           class="btn btn-sm btn-info">
                                            <i class="fas fa-eye me-1"></i> View Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-hide alerts after 5 seconds
        $(document).ready(function () {
            setTimeout(function () {
                $(".alert-dismissible").fadeOut("slow");
            }, 5000);
        });
    </script>
}