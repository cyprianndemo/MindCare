@model List<MindCare.ViewModel.PrescriptionViewModel>
@{
    ViewData["Title"] = "My Medications";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="btn" style="background-color: #004085; color: #fff;">
            <h2 class="mb-0">My Medications</h2>
        </div>
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle mr-2"></i> You don't have any prescribed medications at the moment.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="thead-light">
                            <tr>
                                <th>Medication</th>
                                <th>Dosage</th>
                                <th>Frequency</th>
                                <th>Prescribed On</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prescription in Model)
                            {
                                <tr>
                                    <td>@prescription.MedicationName</td>
                                    <td>@prescription.Dosage</td>
                                    <td>@prescription.Frequency</td>
                                    <td>@prescription.PrescriptionDate.ToShortDateString()</td>
                                    <td>
                                        <span class="badge @(prescription.Status == "Active" ? "badge-success" : "badge-secondary")">
                                            @prescription.Status
                                        </span>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("StudentMedicationDetails", "Pharmacy", new { prescriptionId = prescription.PrescriptionId })" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i> View Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>