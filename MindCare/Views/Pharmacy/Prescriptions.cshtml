@model List<MindCare.ViewModel.PrescriptionViewModel>
@{
    ViewData["Title"] = "Prescription List";
    Layout = "_PsychiatristLayout";
}

<div class="container mt-4">
    <h2 class="mb-4">Prescription List</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" style="background-color: #d4edda; color: #155724; border-color: #c3e6cb;">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            No prescriptions found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead style="background-color: #004085; color: #fff;">
                    <tr>
                        <th>Medication</th>
                        <th>Patient</th>
                        <th>Prescribed By</th>
                        <th>Dosage</th>
                        <th>Frequency</th>
                        <th>Duration</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prescription in Model)
                    {
                        <tr>
                            <td>@prescription.MedicationName</td>
                            <td>@(prescription.Student != null ? $"{prescription.Student.FirstName} {prescription.Student.LastName}" : "Unknown")</td>
                            <td>@(prescription.Psychiatrist != null ? $"Dr. {prescription.Psychiatrist.FirstName} {prescription.Psychiatrist.LastName}" : "Unknown")</td>
                            <td>@prescription.Dosage</td>
                            <td>@prescription.Frequency</td>
                            <td>@prescription.Duration</td>
                            <td>@prescription.PrescriptionDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge @(prescription.Status == "Active" ? "bg-success" : "bg-secondary")">
                                    @prescription.Status
                                </span>
                            </td>
                            <td>
                                <a href="@Url.Action("PrescriptionDetails", "Pharmacy", new { id = prescription.PrescriptionId })" class="btn btn-sm btn-info">
                                    <i class="bi bi-eye"></i> View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>