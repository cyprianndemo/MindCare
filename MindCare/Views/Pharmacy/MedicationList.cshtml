@model IEnumerable<MindCare.Models.Medication>
@{
    ViewData["Title"] = "Medication List";
    Layout = "_PsychiatristLayout";
}

<div class="container mt-4">
    <h2>Medication List</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="mb-3">
        <a class="btn" style="background-color: #004085; color: #fff;" href="@Url.Action("AddMedication", "Pharmacy")">
            <i class="fas fa-plus"></i> Add New Medication
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead style="background-color: #004085; color: #fff;">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Dosage</th>
                    <th>Price</th>
                    <th>Image</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var medication in Model)
                    {
                        <tr id="medication-row-@medication.MedicationId">
                            <td>@medication.Name</td>
                            <td>@medication.Description</td>
                            <td>@medication.Dosage</td>
                            <td>@medication.Price.ToString("C")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(medication.ImagePath))
                                {
                                    <img src="~/images/medications/@medication.ImagePath"
                                         alt="@medication.Name"
                                         class="img-thumbnail"
                                         style="max-width: 100px;" />
                                }
                                else
                                {
                                    <span class="text-muted">No image</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("Edit", "Pharmacy", new { id = medication.MedicationId })"
                                       class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a href="@Url.Action("PrescribeMedication", "Pharmacy", new { id = medication.MedicationId })"
                                       class="btn btn-primary btn-sm">
                                        <i class="fas fa-prescription"></i> Prescribe
                                    </a>
                                    <button type="button"
                                            class="btn btn-danger btn-sm delete-medication"
                                            data-id="@medication.MedicationId"
                                            data-name="@medication.Name">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">No medications found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete the medication: <span id="medicationName"></span>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let medicationIdToDelete = null;

            $('.delete-medication').click(function () {
                medicationIdToDelete = $(this).data('id');
                const medicationName = $(this).data('name');
                $('#medicationName').text(medicationName);
                $('#deleteModal').modal('show');
            });

            $('#confirmDelete').click(function () {
                if (medicationIdToDelete) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Pharmacy")/' + medicationIdToDelete,
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (result) {
                            if (result.success) {
                                $('#medication-row-' + medicationIdToDelete).remove();
                                $('#deleteModal').modal('hide');
                                // Show success message
                                const alert = $('<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                                    result.message +
                                    '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                                    '</div>');
                                $('.container').prepend(alert);
                            } else {
                                alert(result.message);
                            }
                        },
                        error: function () {
                            alert('Error occurred while deleting the medication.');
                        }
                    });
                }
            });
        });
    </script>
}