@model IEnumerable<MindCare.ViewModel.AppointmentViewModel>
@{
    Layout = "_PsychiatristLayout";
    ViewData["Title"] = "Confirmed Appointments";
}
<div class="container my-5">
    <h1 class="text-center" style="color: #004085;">Confirmed Appointments</h1>
    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No approved appointments found.
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var appointment in Model)
            {
                <div class="list-group-item" id="appointment-@appointment.AppointmentId">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1">
                                <strong>Student:</strong> @appointment.StudentName<br />
                                <strong>Email:</strong> @appointment.StudentEmail<br />
                                <strong>Date:</strong> @appointment.Date.ToShortDateString()<br />
                                <strong>Time:</strong> @appointment.Time<br />
                                <strong>Status:</strong> <span class="status-badge badge bg-success">@appointment.Status</span>
                            </p>
                        </div>
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-danger delete-appointment me-1"
                                    data-appointment-id="@appointment.AppointmentId">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                            <a href="@Url.Action("CancelAppointment", new { id = appointment.AppointmentId })" class="btn btn-sm btn-warning me-1">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                            <a href="@Url.Action("EditAppointment", new { id = appointment.AppointmentId })" class="btn btn-sm btn-secondary">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    <div class="text-center mt-4">
        <a asp-action="Index" asp-controller="Psychiatrist" class="btn" style="background-color: #004085; color: #fff;">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.delete-appointment').click(function (e) {
                e.preventDefault();
                var appointmentId = $(this).data('appointment-id');
                var listItem = $(this).closest('.list-group-item');

                if (confirm('Are you sure you want to delete this appointment?')) {
                    $.ajax({
                        url: '@Url.Action("DeleteAppointment", "Psychiatrist")',
                        type: 'POST',
                        data: {
                            id: appointmentId,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (result) {
                            if (result.success) {
                                // Remove the appointment from the list
                                listItem.remove();
                                alert('Appointment deleted successfully.');
                            } else {
                                alert(result.message || 'Failed to delete appointment.');
                            }
                        },
                        error: function () {
                            alert('An error occurred while deleting the appointment.');
                        }
                    });
                }
            });
        });
    </script>
}

@Html.AntiForgeryToken()