@model MindCare.ViewModel.PatientHistoryViewModel
@{
    Layout = "_PsychiatristLayout";
    ViewData["Title"] = "Patient History";
}

<div class="container mt-4">
    <h2 class="mb-4">Patient History</h2>

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Psychiatrist")">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("PatientList", "Psychiatrist")">Patient List</a></li>
            <li class="breadcrumb-item active">Patient History</li>
        </ol>
    </nav>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["Error"]
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title mb-0">Patient Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Name:</strong> @Model.PatientName</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Total Appointments:</strong> @Model.Appointments.Count</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">Appointment History</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>Duration</th>
                            <th>Status</th>
                            <th>Booked On</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Appointments != null && Model.Appointments.Any())
                        {
                            @foreach (var appointment in Model.Appointments)
                            {
                                <tr>
                                    <td>@appointment.StartTime.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>@((appointment.EndTime - appointment.StartTime).TotalMinutes) minutes</td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(appointment.Status)">
                                            @appointment.Status
                                        </span>
                                    </td>
                                    <td>@appointment.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>
                                        @if (appointment.Status == "Pending")
                                        {
                                            <div class="btn-group" role="group">
                                                <button onclick="approveAppointment(@appointment.AppointmentId)"
                                                        class="btn btn-sm btn-success">
                                                    Approve
                                                </button>
                                                <a href="@Url.Action("CancelAppointment", "Psychiatrist", new { id = appointment.AppointmentId })"
                                                   class="btn btn-sm btn-danger">
                                                    Cancel
                                                </a>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">No appointment history found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function approveAppointment(appointmentId) {
            if (confirm('Are you sure you want to approve this appointment?')) {
                $.post('@Url.Action("ApproveAppointment", "Psychiatrist")', { appointmentId: appointmentId })
                    .done(function (response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    })
                    .fail(function () {
                        alert('An error occurred while processing your request.');
                    });
            }
        }
    </script>
}

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status.ToLower() switch
        {
            "pending" => "bg-warning",
            "approved" => "bg-success",
            "cancelled" => "bg-danger",
            "completed" => "bg-primary",
            _ => "bg-secondary"
        };
    }
}