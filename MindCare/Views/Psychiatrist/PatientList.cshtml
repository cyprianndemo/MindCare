@model IEnumerable<MindCare.ViewModel.PatientViewModel>
@{
    Layout = "_PsychiatristLayout";
    ViewData["Title"] = "Patient List";
}

<div class="container mt-4">
    <h2 class="mb-4">My Patients</h2>

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Psychiatrist")">Dashboard</a></li>
            <li class="breadcrumb-item active">Patient List</li>
        </ol>
    </nav>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["Error"]
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">Patient List</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Last Appointment</th>
                            <th>Total Appointments</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var patient in Model)
                            {
                                <tr>
                                    <td>@patient.Name</td>
                                    <td>@patient.Email</td>
                                    <td>
                                        @(patient.LastAppointment.ToString("MMM dd, yyyy HH:mm"))
                                    </td>
                                    <td>@patient.TotalAppointments</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("ViewPatientHistory", "Psychiatrist", new { id = patient.StudentId })"
                                               class="btn btn-sm btn-info">
                                                View History
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">No patients found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize any JavaScript functionality here
        });
    </script>
}