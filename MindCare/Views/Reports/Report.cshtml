@model MindCare.TherapistReport.TherapistReportViewModel
@{
    ViewData["Title"] = "Therapist Report";
    Layout = "_TherapistLayout";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header text-white" style="background-color: #004085;">
            <h2 class="mb-0">Therapist Session Report</h2>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-12">
                    <h3 class="text-primary">@Model.TherapistName</h3>
                    <p class="text-muted">Report generated on @DateTime.Now.ToString("MMM dd, yyyy HH:mm")</p>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h4 class="card-title">Total Sessions</h4>
                            <h2 class="display-4">@Model.TotalSessions</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-white" style="background-color: #004085;">
                        <div class="card-body text-center">
                            <h4 class="card-title">Pending Sessions</h4>
                            <h2 class="display-4">@Model.PendingSessions</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-white" style="background-color: #004085;">
                        <div class="card-body text-center">
                            <h4 class="card-title">Approved Sessions</h4>
                            <h2 class="display-4">@Model.ApprovedSessions</h2>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-header text-white" style="background-color: #004085;">
                            <h4 class="mb-0">Upcoming Pending Appointments</h4>
                        </div>
                        <div class="card-body p-0">
                            @if (Model.UpcomingPendingAppointments.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>Date & Time</th>
                                                <th>Student</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var appointment in Model.UpcomingPendingAppointments)
                                            {
                                                <tr>
                                                    <td>
                                                        @appointment.StartTime.ToLocalTime().ToString("MMM dd, yyyy")<br />
                                                        <small class="text-muted">
                                                            @appointment.StartTime.ToLocalTime().ToString("HH:mm") -
                                                            @appointment.EndTime.ToLocalTime().ToString("HH:mm")
                                                        </small>
                                                    </td>
                                                    <td>
                                                        @appointment.StudentName<br />
                                                        <small class="text-muted">@appointment.StudentEmail</small>
                                                    </td>
                                                    <td>
                                                        <a href="@Url.Action("ManageSessions", "Therapist")" class="btn text-white" style="background-color: #004085;">
                                                            Manage
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="p-3 text-center">
                                    <p class="mb-0">No pending appointments</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-header text-white" style="background-color: #004085;">
                            <h4 class="mb-0">Upcoming Confirmed Appointments</h4>
                        </div>
                        <div class="card-body p-0">
                            @if (Model.UpcomingApprovedAppointments.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>Date & Time</th>
                                                <th>Student</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var appointment in Model.UpcomingApprovedAppointments)
                                            {
                                                <tr>
                                                    <td>
                                                        @appointment.StartTime.ToLocalTime().ToString("MMM dd, yyyy")<br />
                                                        <small class="text-muted">
                                                            @appointment.StartTime.ToLocalTime().ToString("HH:mm") -
                                                            @appointment.EndTime.ToLocalTime().ToString("HH:mm")
                                                        </small>
                                                    </td>
                                                    <td>
                                                        @appointment.StudentName<br />
                                                        <small class="text-muted">@appointment.StudentEmail</small>
                                                    </td>
                                                    <td>
                                                        <a href="@Url.Action("ApprovedAppointments", "Therapist")" class="btn text-white" style="background-color: #004085;">
                                                            View
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="p-3 text-center">
                                    <p class="mb-0">No approved appointments</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12 text-end">
                    <a href="@Url.Action("ManageSessions", "Therapist")" class="btn text-white" style="background-color: #004085;">
                        <i class="bi bi-calendar-check"></i> Manage Sessions
                    </a>
                    <button onclick="window.print()" class="btn text-white" style="background-color: #004085;">
                        <i class="bi bi-printer"></i> Print Report
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            
        });
    </script>
}