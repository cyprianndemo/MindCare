@model IEnumerable<MindCare.Models.Appointment>
@{
    Layout = "_TherapistLayout";
    ViewData["Title"] = "Manage Appointments";
}
<div class="container my-5">
    <h1 class="text-center" style="color: #004085;">Manage Appointments</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No pending appointments found.
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var appointment in Model)
            {
                <div class="list-group-item" id="appointment-@appointment.AppointmentId">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1">
                                <strong>Date:</strong> @appointment.Date.ToShortDateString()<br />
                                <strong>Time:</strong> @appointment.Time<br />
                                <strong>StudentId:</strong> @appointment.StudentId<br />
                                <strong>Status:</strong> <span class="status-badge badge bg-warning">@appointment.Status</span>
                            </p>
                        </div>
                        <div class="btn-group">
                            @if (appointment.Status == "Pending")
                            {
                                <button type="button" class="btn btn-success me-2 approve-btn"
                                        data-appointment-id="@appointment.AppointmentId">
                                    <i class="fas fa-check"></i> Confirm Appointment
                                </button>
                                <a href="@Url.Action("CancelAppointment", new { id = appointment.AppointmentId })"
                                   class="btn btn-danger me-2">
                                    <i class="fas fa-times"></i> Cancel Appointment
                                </a>
                            }
                            <a href="@Url.Action("EditAppointment", new { id = appointment.AppointmentId })"
                               class="btn btn-warning">
                                <i class="fas fa-edit"></i> Edit Appointment
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    <div class="text-center mt-4">
        <a asp-action="Index" asp-controller="Therapist"
           class="btn" style="background-color: #004085; color: #fff;">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.approve-btn').click(function (e) {
                e.preventDefault();
                var button = $(this);
                var appointmentId = button.data('appointment-id');
                var listItem = button.closest('.list-group-item');

                // Add antiforgery token to request
                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '/Therapist/UpdateAppointmentStatus',
                    type: 'POST',
                    data: {
                        appointmentId: appointmentId,
                        status: 'Approved',
                        __RequestVerificationToken: token
                    },
                    success: function (response) {
                        if (response.success) {
                            // Update the UI
                            listItem.find('.status-badge')
                                .removeClass('bg-warning')
                                .addClass('bg-success')
                                .text('Approved');

                            // Remove the approve and cancel buttons
                            button.closest('.btn-group').find('.approve-btn, .btn-danger').remove();

                            // Show success message
                            alert('Appointment approved successfully!');
                        } else {
                            alert(response.message || 'Failed to approve appointment.');
                        }
                    },
                    error: function (xhr, status, error) {
                        console.log('Error details:', {
                            status: status,
                            error: error,
                            response: xhr.responseText
                        });
                        alert('An error occurred while processing your request. Please check the console for details.');
                    }
                });
            });
        });
    </script>

    @* Add antiforgery token *@
    @Html.AntiForgeryToken()
}