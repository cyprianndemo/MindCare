@model IEnumerable<MindCare.ViewModel.AppointmentViewModel>

@{
    Layout = "_TherapistLayout";
    ViewData["Title"] = "Manage Sessions";
}

<div class="container my-5">
    <h1 class="text-center mb-4" style="color: #004085;">Manage Pending Sessions</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No pending appointments found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="thead-light">
                    <tr>
                        <th>Student Name</th>
                        <th>Student Email</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in Model)
                    {
                        <tr>
                            <td>@appointment.StudentName</td>
                            <td>@appointment.StudentEmail</td>
                            <td>@appointment.Date.ToShortDateString()</td>
                            <td>
                                @appointment.StartTime.ToLocalTime().ToString("hh:mm tt") -
                                @appointment.EndTime.ToLocalTime().ToString("hh:mm tt")
                            </td>
                            <td>
                                <span class="badge bg-warning">@appointment.Status</span>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-success btn-sm approve-btn"
                                            data-appointment-id="@appointment.AppointmentId">
                                        <i class="fas fa-check"></i> Confirm
                                    </button>
                                    <a href="@Url.Action("CancelAppointment", new { id = appointment.AppointmentId })"
                                       class="btn btn-danger btn-sm">
                                        <i class="fas fa-times"></i> Cancel
                                    </a>
                                    <a href="@Url.Action("EditAppointment", new { id = appointment.AppointmentId })"
                                       class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="text-center mt-4">
        <a asp-action="Index" asp-controller="Therapist"
           class="btn" style="background-color: #004085; color: #fff;">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.approve-btn').click(function (e) {
                e.preventDefault();
                var button = $(this);
                var appointmentId = button.data('appointment-id');
                var row = button.closest('tr');

                // Add antiforgery token to request
                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '/Therapist/UpdateAppointmentStatus',
                    type: 'POST',
                    data: {
                        appointmentId: appointmentId,
                        status: 'Approved',
                        __RequestVerificationToken: token
                    },
                    success: function (response) {
                        if (response.success) {
                            // Remove the row from the table
                            row.remove();

                            // Show success message
                            alert('Appointment approved successfully!');
                        } else {
                            alert(response.message || 'Failed to approve appointment.');
                        }
                    },
                    error: function (xhr, status, error) {
                        console.log('Error details:', {
                            status: status,
                            error: error,
                            response: xhr.responseText
                        });
                        alert('An error occurred while processing your request. Please check the console for details.');
                    }
                });
            });
        });
    </script>

    @Html.AntiForgeryToken()
}