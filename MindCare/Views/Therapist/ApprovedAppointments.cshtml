@model IEnumerable<MindCare.Models.Appointment>
@{
    Layout = "_TherapistLayout";
    var count = Model?.Count() ?? 0;
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2>My Approved Appointments</h2>
            <p class="text-muted">Total appointments: @count</p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["Error"]
        </div>
    }

    @if (!Model?.Any() ?? true)
    {
        <div class="alert alert-info" role="alert">
            You currently have no approved appointments.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Student Name</th>
                        <th>Start Time</th>
                        <th>End Time</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in Model)
                    {
                        <tr>
                            <td>
                                @if (appointment.StudentId != null)
                                {
                                    @($"{appointment.StudentId}")
                                }
                                else
                                {
                                    <span class="text-muted">No student info</span>
                                }
                            </td>
                            <td>@appointment.StartTime.ToString("MMM dd, yyyy hh:mm tt")</td>
                            <td>@appointment.EndTime.ToString("MMM dd, yyyy hh:mm tt")</td>
                            <td>
                                <span class="badge bg-success">@appointment.Status</span>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="EditAppointment"
                                       asp-route-id="@appointment.AppointmentId"
                                       class="btn btn-sm btn-primary me-2">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a asp-action="CancelAppointment"
                                       asp-route-id="@appointment.AppointmentId"
                                       class="btn btn-sm btn-danger">
                                        <i class="fas fa-times"></i> Cancel
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Log the number of appointments for debugging
            console.log('Number of appointments:', @count);
        });
    </script>
}