@model IEnumerable<MindCare.Models.Appointment>
@{
    Layout = "_TherapistLayout";
    ViewData["Title"] = "Manage Appointments";
}

<div class="container my-5">
    <h1 class="text-center" style="color: #004085;">Confirmed Appointments</h1>
    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No pending appointments found.
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var appointment in Model)
            {
                <div class="list-group-item" id="appointment-@appointment.AppointmentId">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="mb-1">
                                <strong>Date:</strong> @appointment.Date.ToShortDateString()<br />
                                <strong>Time:</strong> @appointment.Time<br />
                                <strong>Student:</strong> @appointment.StudentId<br />
                                <strong>Status:</strong> <span class="status-badge badge bg-success">@appointment.Status</span>
                            </p>
                        </div>
                        <div class="btn-group">
                            @if (appointment.Status == "Approved")
                            {
                                <a href="@Url.Action("CancelAppointment", new { id = appointment.AppointmentId })" class="btn btn-danger me-2">
                                    <i class="fas fa-times"></i> Cancel Appointment
                                </a>
                            }
                            <a href="@Url.Action("EditAppointment", new { id = appointment.AppointmentId })" class="btn btn-warning">
                                <i class="fas fa-edit"></i> Edit Appointment
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    <div class="text-center mt-4">
        <a asp-action="Index" asp-controller="Therapist" class="btn" style="background-color: #004085; color: #fff;">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>