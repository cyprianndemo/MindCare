<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Student Dashboard</title>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
    @await RenderSectionAsync("Styles", required: false)

    <style>
        /* General Styling */
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f8fa;
            color: #333;
            overflow-x: hidden;
        }

        /* Top Navigation Bar */
        .app-bar {
            background-color: #004085;
            color: white;
            padding: 0.5rem 1rem;
            position: fixed;
            width: 100%;
            z-index: 1030;
            top: 0;
        }

        #sidebarToggle {
            background: none;
            border: none;
            color: white;
            font-size: 1.5rem;
            padding: 0.25rem 0.75rem;
            cursor: pointer;
        }

        /* Sidebar Styling */
        .side-nav {
            position: fixed;
            top: 56px; /* Height of navbar */
            bottom: 0;
            left: 0;
            width: 250px;
            background-color: #004085;
            color: white;
            transition: transform 0.3s ease-in-out;
            z-index: 1020;
            overflow-y: auto;
        }

        .side-nav.collapsed {
            transform: translateX(-250px);
        }

        .side-nav .nav-link {
            color: white;
            font-size: 1.1rem;
            padding: 10px 20px;
            text-decoration: none;
            display: flex;
            align-items: center;
        }

        .side-nav .nav-link:hover {
            background-color: #003060;
            border-radius: 5px;
        }

        /* Main Content Styling */
        .main-content {
            margin-left: 250px;
            margin-top: 56px; /* Height of navbar */
            padding: 20px;
            min-height: calc(100vh - 56px);
            transition: margin-left 0.3s ease-in-out;
            background-color: #ffffff;
        }

        .main-content.expanded {
            margin-left: 0;
        }

        /* Icons for Navigation Items */
        .nav-item-icon {
            margin-right: 10px;
            width: 20px;
            text-align: center;
        }

        /* Footer Styling */
        .footer {
            margin-left: 250px;
            transition: margin-left 0.3s ease-in-out;
            padding: 1rem;
            background-color: #f8f9fa;
        }

        .footer.expanded {
            margin-left: 0;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .side-nav {
                transform: translateX(-250px);
            }

            .side-nav.show {
                transform: translateX(0);
            }

            .main-content {
                margin-left: 0;
            }

            .footer {
                margin-left: 0;
            }
        }

        /* Overlay for mobile */
        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1015;
        }

        .sidebar-overlay.show {
            display: block;
        }
        /* Hover dropdown styles */
        .dropdown-hover {
            position: relative;
        }

        .hover-menu {
            display: none;
            position: absolute;
            left: 100%;
            top: 0;
            min-width: 150px;
            background-color: #fff;
            box-shadow: 0 8px 16px rgba(0,0,0,0.1);
            z-index: 100;
            border-radius: 4px;
            border: 1px solid rgba(0,0,0,0.15);
        }

        .dropdown-hover:hover .hover-menu {
            display: block;
        }

        .hover-menu-item {
            display: block;
            padding: 0.5rem 1rem;
            clear: both;
            font-weight: 400;
            color: #212529;
            text-align: inherit;
            white-space: nowrap;
            background-color: transparent;
            border: 0;
            text-decoration: none;
        }

            .hover-menu-item:hover {
                background-color: #f8f9fa;
                color: #16181b;
                text-decoration: none;
            }
    </style>
</head>
<body>
    <!-- Top Navigation Bar -->
    <nav class="navbar navbar-expand-lg app-bar">
        <div class="container-fluid">
            <button id="sidebarToggle" type="button">
                <i class="fas fa-bars"></i>
            </button>
            <a class="navbar-brand text-white ml-2" href="#">Student Dashboard</a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Notification" asp-action="Index">
                            <i class="fas fa-bell"></i> Notifications
                        </a>
                    </li>

                    <li class="nav-item">
                        <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                            <button id="logout" type="submit" class="nav-link btn btn-link text-white border-0">
                                <i class="fas fa-sign-out-alt"></i> Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Sidebar Overlay -->
    <div class="sidebar-overlay"></div>

    <!-- Sidebar Navigation -->
    <nav class="side-nav">
        <div class="position-sticky">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Dashboard", "Student")">
                        <span class="nav-item-icon"><i class="fas fa-home"></i></span> Dashboard
                    </a>
                </li>
                <li class="nav-item dropdown-hover">
                    <a class="nav-link" href="@Url.Action("TherapySessions", "Therapy")">
                        <span class="nav-item-icon"><i class="fas fa-comments"></i></span> Therapy Sessions
                    </a>
                    <div class="hover-menu">
                        <a class="hover-menu-item" href="@Url.Action("TherapySessions", "Therapy", new { status = "All" })">
                            All Sessions
                        </a>
                        <a class="hover-menu-item" href="@Url.Action("TherapySessions", "Therapy", new { status = "Pending" })">
                            Pending Sessions
                        </a>
                        <a class="hover-menu-item" href="@Url.Action("TherapySessions", "Therapy", new { status = "Approved" })">
                            Confirmed Sessions
                        </a>
                    </div>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Mood")">
                        <span class="nav-item-icon"><i class="fas fa-smile"></i></span> Mood
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("PsychiatrySessions", "Psychiatry")">
                        <span class="nav-item-icon"><i class="fas fa-user-md"></i></span> Psychiatry Sessions
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "PeerSupport")">
                        <span class="nav-item-icon"><i class="fas fa-user-friends"></i></span> Peer Support
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Resources")">
                        <span class="nav-item-icon"><i class="fas fa-book"></i></span> Mental Health Resources
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("MyPrescriptions", "Pharmacy")">
                        <span class="nav-item-icon"><i class="fas fa-pills"></i></span> Pharmacy
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Cart")">
                        <span class="nav-item-icon"><i class="fas fa-shopping-cart"></i></span> My Cart
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Chat")">
                        <span class="nav-item-icon"><i class="fas fa-comment"></i></span> Chat with Us
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Create", "Feedback")">
                        <span class="nav-item-icon"><i class="fas fa-pencil-alt"></i></span> Feedback
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Page("/Account/Manage/Index", new { area = "Identity" })">
                        <span class="nav-item-icon"><i class="fas fa-user"></i></span> Profile
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - MindCare - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sideNav = document.querySelector('.side-nav');
            const mainContent = document.querySelector('.main-content');
            const footer = document.querySelector('.footer');
            const overlay = document.querySelector('.sidebar-overlay');

            function toggleSidebar() {
                sideNav.classList.toggle('collapsed');
                mainContent.classList.toggle('expanded');
                footer.classList.toggle('expanded');
                
                if (window.innerWidth <= 768) {
                    sideNav.classList.toggle('show');
                    overlay.classList.toggle('show');
                }
            }

            sidebarToggle.addEventListener('click', toggleSidebar);
            overlay.addEventListener('click', toggleSidebar);

            // Handle window resize
            window.addEventListener('resize', function() {
                if (window.innerWidth > 768) {
                    overlay.classList.remove('show');
                    sideNav.classList.remove('show');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>