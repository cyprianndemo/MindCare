@model MindCare.ViewModel.StudentReportViewModel
@{
    ViewData["Title"] = "Student Health Report";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="text-white">Student Health Report</h2>
            <h4>@Model.StudentName</h4>
            <p>Report generated on: @Model.ReportGeneratedDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</p>
        </div>
        <div class="col-md-4 text-end">
            <button id="exportPdfBtn" class="btn" style="background-color: #004085;">
                <i class="fas fa-file-pdf"></i> Export to PDF
            </button>
        </div>
    </div>

    <div class="row">
        <!-- Therapy Statistics Card -->
        <div class="col-md-6 mb-4">
            <div class="card border-primary h-100">
                <div class="card-header text-white" style="background-color: #004085;">
                    <h5 class="mb-0">Therapy Sessions Summary</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <div class="stat-item">
                                <span class="stat-label">Total Sessions:</span>
                                <span class="stat-value">@Model.TotalTherapySessions</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Pending:</span>
                                <span class="stat-value">@Model.PendingTherapySessions</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Approved:</span>
                                <span class="stat-value">@Model.ApprovedTherapySessions</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-item">
                                <span class="stat-label">Completed:</span>
                                <span class="stat-value">@Model.CompletedTherapySessions</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Cancelled:</span>
                                <span class="stat-value">@Model.CancelledTherapySessions</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Psychiatry Statistics Card -->
        <div class="col-md-6 mb-4">
            <div class="card border-success h-100">
                <div class="card-header text-white" style="background-color: #004085;">
                    <h5 class="mb-0">Psychiatry Sessions Summary</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <div class="stat-item">
                                <span class="stat-label">Total Sessions:</span>
                                <span class="stat-value">@Model.TotalPsychiatrySessions</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Pending:</span>
                                <span class="stat-value">@Model.PendingPsychiatrySessions</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Approved:</span>
                                <span class="stat-value">@Model.ApprovedPsychiatrySessions</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-item">
                                <span class="stat-label">Completed:</span>
                                <span class="stat-value">@Model.CompletedPsychiatrySessions</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Cancelled:</span>
                                <span class="stat-value">@Model.CancelledPsychiatrySessions</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Medications Summary Card -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-info">
                <div class="card-header text-white" style="background-color: #004085;">
                    <h5 class="mb-0">Medications Summary</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="stat-item">
                                <span class="stat-label">Total Prescriptions:</span>
                                <span class="stat-value">@Model.TotalPrescriptions</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-item">
                                <span class="stat-label">Active Medications:</span>
                                <span class="stat-value">@Model.ActivePrescriptionsCount</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-item">
                                <span class="stat-label">Inactive Medications:</span>
                                <span class="stat-value">@Model.InactivePrescriptionsCount</span>
                            </div>
                        </div>
                    </div>

                    @if (Model.ActivePrescriptions.Any())
                    {
                        <h6 class="mb-3">Current Active Medications:</h6>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Medication</th>
                                        <th>Dosage</th>
                                        <th>Frequency</th>
                                        <th>Instructions</th>
                                        <th>Prescribed By</th>
                                        <th>Prescribed Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var prescription in Model.ActivePrescriptions)
                                    {
                                        <tr>
                                            <td>@prescription.Medication.Name</td>
                                            <td>@prescription.Dosage</td>
                                            <td>@prescription.Frequency</td>
                                            <td>@prescription.Instructions</td>
                                            <td>
                                                @if (Model.PsychiatristNames.TryGetValue(prescription.PsychiatristId, out string psychiatristName))
                                                {
                                                    @psychiatristName
                                                }
                                                else
                                                {
                                                    <span>Unknown</span>
                                                }
                                            </td>
                                            <td>@prescription.PrescriptionDate.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert text-white" style="background-color: #004085;">You currently have no active medications prescribed.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Upcoming Appointments Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-warning">
                <div class="card-header text-white" style="background-color: #004085;">
                    <h5 class="mb-0">Upcoming Appointments</h5>
                </div>
                <div class="card-body">
                    <!-- Upcoming Therapy Appointments -->
                    @if (Model.UpcomingTherapyAppointments.Any())
                    {
                        <h6 class="mb-3">Upcoming Therapy Sessions:</h6>
                        <div class="table-responsive mb-4">
                            <table class="table table-striped table-hover">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Date & Time</th>
                                        <th>Therapist</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in Model.UpcomingTherapyAppointments)
                                    {
                                        <tr>
                                            <td>@appointment.StartTime.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                            <td>
                                                @if (Model.TherapistNames.TryGetValue(appointment.TherapistId, out string therapistName))
                                                {
                                                    @therapistName
                                                }
                                                else
                                                {
                                                    <span>Unknown</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @(appointment.Status == "Pending" ? "bg-warning" : "bg-success")">
                                                    @appointment.Status
                                                </span>
                                            </td>
                                            <td>
                                                <a asp-controller="Therapy" asp-action="SessionDetails" asp-route-id="@appointment.AppointmentId" class="btn btn-sm btn-primary">
                                                    Details
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert text-white mb-4" style="background-color: #004085;">You have no upcoming therapy appointments.</div>
                    }

                    <!-- Upcoming Psychiatry Appointments -->
                    @if (Model.UpcomingPsychiatryAppointments.Any())
                    {
                        <h6 class="mb-3">Upcoming Psychiatry Sessions:</h6>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Date & Time</th>
                                        <th>Psychiatrist</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in Model.UpcomingPsychiatryAppointments)
                                    {
                                        <tr>
                                            <td>@appointment.StartTime.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                            <td>
                                                @if (Model.PsychiatristNames.TryGetValue(appointment.PsychiatristId, out string psychiatristName))
                                                {
                                                    @psychiatristName
                                                }
                                                else
                                                {
                                                    <span>Unknown</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @(appointment.Status == "Pending" ? "bg-warning" : "bg-success")">
                                                    @appointment.Status
                                                </span>
                                            </td>
                                            <td>
                                                <a asp-controller="Therapy" asp-action="SessionDetails" asp-route-id="@appointment.AppointmentId" class="btn btn-sm btn-primary">
                                                    Details
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert text-white" style="background-color: #004085;">You have no upcoming psychiatry appointments.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Appointment History -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-secondary">
                <div class="card-header text-white" style="background-color: #004085;">
                    <h5 class="mb-0">Recent Session History</h5>
                </div>
                <div class="card-body">
                    <ul class="nav nav-tabs" id="appointmentTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="therapy-tab" data-bs-toggle="tab" data-bs-target="#therapy" type="button" role="tab" aria-controls="therapy" aria-selected="true">
                                Therapy Sessions
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="psychiatry-tab" data-bs-toggle="tab" data-bs-target="#psychiatry" type="button" role="tab" aria-controls="psychiatry" aria-selected="false">
                                Psychiatry Sessions
                            </button>
                        </li>
                    </ul>
                    <div class="tab-content p-3" id="appointmentTabContent">
                        <div class="tab-pane fade show active" id="therapy" role="tabpanel" aria-labelledby="therapy-tab">
                            @if (Model.RecentTherapyAppointments.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Therapist</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var appointment in Model.RecentTherapyAppointments)
                                            {
                                                <tr>
                                                    <td>@appointment.StartTime.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                                    <td>
                                                        @if (Model.TherapistNames.TryGetValue(appointment.TherapistId, out string therapistName))
                                                        {
                                                            @therapistName
                                                        }
                                                        else
                                                        {
                                                            <span>Unknown</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-success">@appointment.Status</span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert text-white" style="background-color: #004085;">No recent therapy sessions found.</div>
                            }
                        </div>
                        <div class="tab-pane fade" id="psychiatry" role="tabpanel" aria-labelledby="psychiatry-tab">
                            @if (Model.RecentPsychiatryAppointments.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Psychiatrist</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var appointment in Model.RecentPsychiatryAppointments)
                                            {
                                                <tr>
                                                    <td>@appointment.StartTime.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                                    <td>
                                                        @if (Model.PsychiatristNames.TryGetValue(appointment.PsychiatristId, out string psychiatristName))
                                                        {
                                                            @psychiatristName
                                                        }
                                                        else
                                                        {
                                                            <span>Unknown</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-success">@appointment.Status</span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert text-white" style="background-color: #004085;">No recent psychiatry sessions found.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Add html2pdf.js library reference -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Get the export button
            const exportButton = document.getElementById('exportPdfBtn');

            if (exportButton) {
                // Add click event listener
                exportButton.addEventListener('click', function () {
                    generatePDF();
                });
            }
        });

        function generatePDF() {
            // Show loading indicator
            const loadingIndicator = document.createElement('span');
            loadingIndicator.innerHTML = ' <i class="fas fa-spinner fa-spin"></i> Generating PDF...';
            document.getElementById('exportPdfBtn').appendChild(loadingIndicator);

            // Use html2pdf.js library to convert the report to PDF
            const element = document.querySelector('.container');
            const opt = {
                margin: 10,
                filename: 'Student_Health_Report.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            html2pdf().set(opt).from(element).save().then(function () {
                // Remove loading indicator when done
                loadingIndicator.remove();
            });
        }
    </script>
}
@section Styles {
    <style>
        .stat-item {
            margin-bottom: 10px;
        }

        .stat-label {
            font-weight: 500;
        }

        .stat-value {
            font-weight: 700;
            margin-left: 5px;
        }

        .card {
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .table th {
            background-color: #f8f9fa;
        }
    </style>
}