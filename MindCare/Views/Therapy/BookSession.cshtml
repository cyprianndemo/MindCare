@model Appointment
@{
    ViewData["Title"] = "Book Therapy Session";
}

<div class="container">
    <h2>Book Therapy Session</h2>

    <form asp-action="BookSession" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="TherapistId" class="control-label"></label>
            <select asp-for="TherapistId" class="form-control" asp-items="ViewBag.Therapists">
                <option value="">Select a therapist...</option>
            </select>
            <span asp-validation-for="TherapistId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Date" class="control-label"></label>
            <input asp-for="Date" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="Date" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Time" class="control-label"></label>
            <input asp-for="Time" class="form-control" type="time" />
            <span asp-validation-for="Time" class="text-danger"></span>
        </div>

        <div class="form-group mt-3">
            <button type="submit" class="btn btn-primary">Book Appointment</button>
            <a asp-action="TherapySessions" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            // Add any client-side validation or dynamic functionality here
        });
    </script>
}