@model MindCare.Models.Appointment

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Appointment Details</title>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f5f8fa;
            color: #333;
            font-family: Arial, sans-serif;
        }

        .text-primary {
            color: #004085;
        }
    </style>
</head>
<body>

    <div class="container my-5">
        <h1 class="text-center text-primary mb-4">Appointment Details</h1>

        <div class="mb-3">
            <h4>Therapist: @Model.Therapist.FirstName @Model.Therapist.LastName</h4>
            <h5>Date: @Model.Date.ToShortDateString() @Model.Time</h5>
            <p>Status: <span class="text-@(Model.Status == "Cancelled" ? "danger" : "success")">@Model.Status</span></p>
@*             <p><strong>Psychiatrist: </strong>@Model.Psychiatrist.FirstName @Model.Psychiatrist.LastName</p>
 *@        </div>

        <div class="text-right mb-3">
            <a href="@Url.Action("Edit", "Therapy", new { id = Model.AppointmentId })" class="btn" style="background-color: #004085; color: #fff;">Edit Appointment</a>
            <form action="@Url.Action("Cancel", "Therapy", new { id = Model.AppointmentId })" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn" style="background-color: #004085; color: #fff;">Cancel Appointment</button>
            </form>
        </div>

        <div class="text-center">
            <a href="@Url.Action("TherapySessions", "Therapy")" class="btn" style="background-color: #004085; color: #fff;">Back to Sessions</a>
        </div>
    </div>

</body>
</html>
