@model MindCare.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "Edit User";
    Layout = "_AdminLayout";

}

<div class="container">
    <h2>Edit User</h2>
    <form asp-action="EditUser" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="UserName">Username</label>
            <input class="form-control" asp-for="UserName" />
        </div>

        <div class="form-group">
            <label asp-for="Email">Email</label>
            <input class="form-control" asp-for="Email" />
        </div>

        <div class="form-group">
            <label>Roles</label>
            @foreach (var role in Model.Roles)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="@role.Selected" />
                    <label class="form-check-label">@role.RoleName</label>
                </div>
            }
        </div>

        <button type="submit" class="btn btn-primary mt-3">Save Changes</button>
        <a href="@Url.Action("ManageUsers", "Admin")" class="btn btn-secondary mt-3">Cancel</a>
    </form>
</div>
