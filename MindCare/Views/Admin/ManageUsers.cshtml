@using Microsoft.AspNetCore.Identity
@model IEnumerable<ApplicationUser>

@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Manage Users";
    Layout = "_AdminLayout";

}

<div class="container">
    <h2>Manage Users</h2>
    <p>Here you can view, edit, assign roles, and delete users.</p>

    <table class="table table-striped mt-4">
        <thead>
            <tr>
                <th>User Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    <td>@string.Join(", ", await UserManager.GetRolesAsync(user))</td>
                    <td>
                        <a href="@Url.Action("EditUser", "Admin", new { id = user.Id })" class="btn btn-warning btn-sm">Edit</a>
                        <a href="@Url.Action("DeleteUser", "Admin", new { id = user.Id })" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
