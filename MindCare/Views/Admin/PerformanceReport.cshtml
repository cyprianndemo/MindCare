@model MindCare.ViewModel.PerformanceReportViewModel
@{
    ViewData["Title"] = "Performance Report";
    Layout = "_AdminLayout";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">System Performance Report</h2>

    <div class="row">
        <!-- User counts -->
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Total Students</h5>
                    <p class="card-text display-4">@Model.StudentCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Total Therapists</h5>
                    <p class="card-text display-4">@Model.TherapistCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Total Psychiatrists</h5>
                    <p class="card-text display-4">@Model.PsychiatristCount</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <!-- Session stats -->
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-secondary">
                <div class="card-body">
                    <h5 class="card-title">Total Sessions</h5>
                    <p class="card-text display-4">@Model.TotalSessions</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Completed Sessions</h5>
                    <p class="card-text display-4">@Model.CompletedSessions</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-danger">
                <div class="card-body">
                    <h5 class="card-title">Upcoming Sessions</h5>
                    <p class="card-text display-4">@Model.UpcomingSessions</p>
                </div>
            </div>
        </div>
    </div>
</div>
