@{
    ViewData["Title"] = "View Reports";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <h2 class="mt-4">System Reports</h2>
    <p class="lead">Access comprehensive system reports and analytics</p>

    <div class="row">
        <div class="col-xl-6 col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-line me-1"></i>
                    System Performance Report
                </div>
                <div class="card-body">
                    <p>Provides an overview of system activity, user engagement, and performance metrics for decision-making.</p>
                    <h6>Report Contents:</h6>
                    <ul>
                        <li>Total number of registered users (students, therapists, psychiatrists)</li>
                        <li>Monthly active users and session booking statistics</li>
                        <li>System performance metrics (uptime, error logs, response times)</li>
                        <li>User feedback and common technical issues</li>
                    </ul>
                    <a href="@Url.Action("SystemPerformanceReport", "Admin")" class="btn btn-primary">
                        <i class="fas fa-eye"></i> View Report
                    </a>
                </div>
            </div>
        </div>

        <div class="col-xl-6 col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-money-bill-wave me-1"></i>
                    Financial Transactions Report
                </div>
                <div class="card-body">
                    <p>Provides a detailed analysis of payment transactions and financial activity in the system.</p>
                    <h6>Report Contents:</h6>
                    <ul>
                        <li>Total payments received and transaction statistics</li>
                        <li>Payment method usage breakdown</li>
                        <li>Monthly financial trends</li>
                        <li>Transaction status summary</li>
                    </ul>
                    <a href="@Url.Action("FinancialTransactionsReport", "Admin")" class="btn btn-primary">
                        <i class="fas fa-eye"></i> View Report
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-6 col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-user-clock me-1"></i>
                    User Activity Report
                </div>
                <div class="card-body">
                    <p>Track user login, session bookings, and other important system activities.</p>
                    <a href="@Url.Action("UserActivityReport", "Admin")" class="btn btn-primary">
                        <i class="fas fa-eye"></i> View Report
                    </a>
                </div>
            </div>
        </div>

        <div class="col-xl-6 col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-bar me-1"></i>
                    System Usage Report
                </div>
                <div class="card-body">
                    <p>Review system usage statistics including session counts and trends.</p>
                    <a href="@Url.Action("SystemUsageReport", "Admin")" class="btn btn-primary">
                        <i class="fas fa-eye"></i> View Report
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>