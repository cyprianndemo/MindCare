@model MindCare.Models.Payment
@{
    ViewData["Title"] = "Waiting for M-Pesa Payment";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <i class="fas fa-mobile-alt text-primary" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="mb-4">Complete Your M-Pesa Payment</h2>

                    <div class="alert alert-info mb-4">
                        <p>An STK push has been sent to your phone.</p>
                        <p>Please enter your M-Pesa PIN to complete the payment of <strong>KES @Model.Amount</strong>.</p>
                    </div>

                    <div id="timer-display" class="mb-3">
                        <div class="progress" style="height: 10px;">
                            <div id="timer-bar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                                 role="progressbar" style="width: 100%"></div>
                        </div>
                        <p class="mt-2">Time remaining: <span id="countdown">45</span> seconds</p>
                    </div>

                    <div id="loading-indicator" class="mb-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Waiting for payment confirmation...</p>
                    </div>

                    <div id="payment-status" class="mb-4 d-none">
                        <div id="success-icon" class="d-none">
                            <i class="fas fa-check-circle text-success" style="font-size: 3rem;"></i>
                            <p class="mt-2 text-success">Payment successful!</p>
                        </div>
                        <div id="error-icon" class="d-none">
                            <i class="fas fa-times-circle text-danger" style="font-size: 3rem;"></i>
                            <p class="mt-2 text-danger">Payment failed!</p>
                        </div>
                        <p id="status-message" class="mt-2"></p>
                    </div>

                    <div class="d-none" id="receipt-btn-container">
                        <a id="receipt-btn" href="#" class="btn btn-primary me-2">View Receipt</a>
                        <a href="/" class="btn btn-outline-secondary">Return Home</a>
                    </div>

                    <a href="@Url.Action("Pay", "Checkout", new { appointmentId = Model.AppointmentId })" class="btn btn-outline-danger mt-3 d-none" id="try-again-btn">Try Again</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Add Font Awesome for icons if not already included -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const transactionId = '@Model.TransactionId';
            const loadingIndicator = document.getElementById('loading-indicator');
            const paymentStatus = document.getElementById('payment-status');
            const successIcon = document.getElementById('success-icon');
            const errorIcon = document.getElementById('error-icon');
            const statusMessage = document.getElementById('status-message');
            const receiptBtnContainer = document.getElementById('receipt-btn-container');
            const receiptBtn = document.getElementById('receipt-btn');
            const tryAgainBtn = document.getElementById('try-again-btn');
            const timerDisplay = document.getElementById('timer-display');
            const timerBar = document.getElementById('timer-bar');
            const countdown = document.getElementById('countdown');

            // Timer setup - 45 seconds timeout
            let timeLeft = 45;
            let timerInterval;
            let checkInterval;

            function startTimer() {
                timerInterval = setInterval(() => {
                    timeLeft--;
                    countdown.textContent = timeLeft;

                    // Update progress bar
                    const percentage = (timeLeft / 45) * 100;
                    timerBar.style.width = `${percentage}%`;

                    if (timeLeft <= 10) {
                        timerBar.classList.remove('bg-primary');
                        timerBar.classList.add('bg-danger');
                    }

                    if (timeLeft <= 0) {
                        clearInterval(timerInterval);
                        clearInterval(checkInterval);

                        // Timeout occurred
                        loadingIndicator.classList.add('d-none');
                        paymentStatus.classList.remove('d-none');
                        errorIcon.classList.remove('d-none');
                        statusMessage.textContent = "Payment timed out. Please try again.";
                        tryAgainBtn.classList.remove('d-none');
                        timerDisplay.classList.add('d-none');

                        // Redirect to fail page after timeout
                        window.location.href = `/Checkout/Fail?transactionId=${transactionId}&reason=timeout`;
                    }
                }, 1000);
            }

            function checkPaymentStatus() {
                fetch(`/Checkout/CheckMpesaPaymentStatus?transactionId=${transactionId}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            // Payment completed successfully
                            clearInterval(timerInterval);
                            clearInterval(checkInterval);

                            loadingIndicator.classList.add('d-none');
                            paymentStatus.classList.remove('d-none');
                            successIcon.classList.remove('d-none');
                            statusMessage.textContent = data.message;
                            receiptBtnContainer.classList.remove('d-none');
                            receiptBtn.href = data.receiptUrl;
                            timerDisplay.classList.add('d-none');

                            // Redirect to receipt page after short delay
                            setTimeout(() => {
                                window.location.href = data.receiptUrl;
                            }, 2000);
                        } else if (data.status === "failed") {
                            // Payment failed
                            clearInterval(timerInterval);
                            clearInterval(checkInterval);

                            loadingIndicator.classList.add('d-none');
                            paymentStatus.classList.remove('d-none');
                            errorIcon.classList.remove('d-none');
                            statusMessage.textContent = data.message;
                            tryAgainBtn.classList.remove('d-none');
                            timerDisplay.classList.add('d-none');

                            // Redirect to fail page after short delay
                            setTimeout(() => {
                                window.location.href = `/Checkout/Fail?transactionId=${transactionId}&reason=failed`;
                            }, 2000);
                        }
                        // If still pending, continue polling
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        // Don't stop the timer or polling on network errors
                    });
            }

            // Start timer
            startTimer();

            // Check immediately, then every 5 seconds
            checkPaymentStatus();
            checkInterval = setInterval(checkPaymentStatus, 5000);
        });
    </script>
}