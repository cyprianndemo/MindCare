@model MindCare.ViewModel.MessagesViewModel

@{
    ViewData["Title"] = "Direct Messages";
}

<div class="container py-4">
    <h1 class="mb-4">Direct Messages</h1>

    <div class="row">
        <!-- Conversation List -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Conversations</h5>
                </div>
                <div class="list-group list-group-flush">
                    @if (Model.Conversations.Any())
                    {
                        @foreach (var conversation in Model.Conversations)
                        {
                            <a href="@Url.Action("DirectMessages", "PeerSupport", new { peerId = conversation.OtherUserId })"
                               class="list-group-item list-group-item-action @(Model.ActiveConversation != null && Model.ActiveConversation.OtherUserId == conversation.OtherUserId ? "active" : "")">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        @if (!string.IsNullOrEmpty(conversation.MoodIcon))
                                        {
                                            <span class="me-2">@conversation.MoodIcon</span>
                                        }
                                        <span>@conversation.OtherUserName</span>
                                    </div>
                                    @if (conversation.UnreadCount > 0)
                                    {
                                        <span class="badge bg-primary rounded-pill">@conversation.UnreadCount</span>
                                    }
                                </div>
                                <p class="mb-1 text-truncate">@conversation.LastMessagePreview</p>
                                <small class="text-muted">
                                    @(conversation.LastMessageTime.HasValue
                                        ? conversation.LastMessageTime.Value.ToString("g")
                                        : "No messages yet")
                                </small>
                            </a>
                        }
                    }
                    else
                    {
                        <div class="list-group-item">
                            <p class="mb-0">No conversations yet.</p>
                            <small>Start a conversation by finding peers.</small>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("FindPeers", "PeerSupport")" class="btn btn-primary btn-sm">
                        <i class="fas fa-search"></i> Find Peers
                    </a>
                </div>
            </div>
        </div>

        <!-- Active Conversation -->
        <div class="col-md-8">
            @if (Model.ActiveConversation != null)
            {
                <div class="card h-100 d-flex flex-column">
                    <div class="card-header">
                        <h5 class="mb-0">
                            @if (!string.IsNullOrEmpty(Model.ActiveConversation.MoodIcon))
                            {
                                <span class="me-2">@Model.ActiveConversation.MoodIcon</span>
                            }
                            @Model.ActiveConversation.OtherUserName
                        </h5>
                    </div>
                    <div class="card-body messages-container overflow-auto flex-grow-1">
                        @if (Model.ActiveConversation.Messages.Any())
                        {
                            @foreach (var message in Model.ActiveConversation.Messages)
                            {
                                <div class="message @(message.IsFromCurrentUser ? "message-sent" : "message-received")">
                                    <div class="message-content">
                                        <div class="message-header">
                                            @if (!message.IsFromCurrentUser)
                                            {
                                                <span class="message-sender">
                                                    @if (!string.IsNullOrEmpty(message.SenderMoodIcon))
                                                    {
                                                        <span class="me-1">@message.SenderMoodIcon</span>
                                                    }
                                                    @message.SenderName
                                                </span>
                                            }
                                            <small class="message-time">@message.CreatedAt.ToString("g")</small>
                                        </div>
                                        <p class="mb-0">@message.Content</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-5">
                                <p>No messages yet. Start the conversation!</p>
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        <form asp-action="SendMessage" method="post">
                            <input type="hidden" asp-for="ActiveConversation.NewMessage.ConversationId" value="@Model.ActiveConversation.ConversationId" />
                            <input type="hidden" asp-for="ActiveConversation.NewMessage.RecipientId" value="@Model.ActiveConversation.OtherUserId" />

                            <div class="input-group">
                                <input type="text" asp-for="ActiveConversation.NewMessage.Content" class="form-control" placeholder="Type your message..." required />
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-paper-plane"></i> Send
                                </button>
                            </div>
                            <span asp-validation-for="ActiveConversation.NewMessage.Content" class="text-danger"></span>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="card h-100">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                        <i class="fas fa-comments fa-4x text-muted mb-3"></i>
                        <h4>Select a conversation</h4>
                        <p class="text-muted">Choose a conversation from the list or start a new one by finding peers.</p>
                        <a href="@Url.Action("FindPeers", "PeerSupport")" class="btn btn-primary mt-3">
                            Find Peers
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        .messages-container {
            max-height: 400px;
            overflow-y: auto;
        }

        .message {
            margin-bottom: 15px;
            max-width: 80%;
        }

        .message-sent {
            margin-left: auto;
        }

        .message-received {
            margin-right: auto;
        }

        .message-content {
            padding: 10px 15px;
            border-radius: 15px;
            position: relative;
        }

        .message-sent .message-content {
            background-color: #dcf8c6;
            border-top-right-radius: 0;
        }

        .message-received .message-content {
            background-color: #f1f0f0;
            border-top-left-radius: 0;
        }

        .message-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
        }

        .message-time {
            font-size: 0.7rem;
            color: #888;
        }

        .message-sender {
            font-weight: 500;
            font-size: 0.8rem;
        }
    </style>
}