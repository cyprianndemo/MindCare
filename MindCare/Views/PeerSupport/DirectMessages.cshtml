@using System.Security.Claims
@model MindCare.ViewModel.MessagesViewModel

@{
    ViewData["Title"] = "Direct Messages";
}

<div class="container-fluid py-4">
    <h1 class="mb-4 text-primary" style="color: #004085;">
        <i class="fas fa-comments me-2"></i>Direct Messages
    </h1>

    <div class="row g-4">
        <!-- Conversation List -->
        <div class="col-md-4 col-lg-3">
            <div class="card shadow h-100">
                <div class="card-header py-3" style="background-color: #004085; color: white;">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-users me-2"></i>Conversations</h5>
                        <button class="btn btn-sm btn-light" id="refresh-conversations" title="Refresh conversations">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush conversation-list" id="conversation-list">
                        @if (Model.Conversations.Any())
                        {
                            @foreach (var conversation in Model.Conversations)
                            {
                                @functions {
                            private string GetRandomColor(string userId)
                            {
                                // Simple example: hash userId to pick a color
                                var colors = new[] { "#FF5733", "#33FF57", "#3357FF", "#FFC300", "#DAF7A6" };
                                int index = Math.Abs(userId.GetHashCode()) % colors.Length;
                                return colors[index];
                            }
                               }

                                <div class="conversation-item" data-conversation-id="@conversation.ConversationId">
                                    <a href="@Url.Action("DirectMessages", "PeerSupport", new { peerId = conversation.OtherUserId })"
                                       class="list-group-item list-group-item-action d-flex flex-column p-3 @(Model.ActiveConversation != null && Model.ActiveConversation.OtherUserId == conversation.OtherUserId ? "active" : "")"
                                       data-user-id="@conversation.OtherUserId">
                                        <div class="d-flex justify-content-between align-items-center w-100">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-circle me-2" style="background-color: @GetRandomColor(conversation.OtherUserId)">
                                                    <span class="initials">@(conversation.OtherUserName.Substring(0, 1).ToUpper())</span>
                                                </div>
                                                <div>
                                                    <span class="fw-semibold">
                                                        @if (!string.IsNullOrEmpty(conversation.MoodIcon))
                                                        {
                                                            <span class="me-1">@conversation.MoodIcon</span>
                                                        }
                                                        @conversation.OtherUserName
                                                    </span>
                                                    @if (conversation.IsOnline)
                                                    {
                                                        <span class="online-indicator ms-2" title="Online"></span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="d-flex">
                                                @if (conversation.UnreadCount > 0)
                                                {
                                                    <span class="badge rounded-pill bg-primary ms-2 unread-count">@conversation.UnreadCount</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center w-100 mt-2">
                                            <p class="mb-0 text-truncate message-preview @(conversation.UnreadCount > 0 ? "fw-semibold" : "text-muted")" style="max-width: 75%;">
                                                @conversation.LastMessagePreview
                                            </p>
                                            @functions {
                                        private string FormatTime(DateTime? time)
                                        {
                                            return time.HasValue ? time.Value.ToString("hh:mm tt") : "";
                                        }
                                           }

                                            <small class="text-muted ms-auto message-time">
                                                @FormatTime(conversation.LastMessageTime)
                                            </small>
                                        </div>
                                    </a>
                                    <button class="btn btn-sm btn-danger delete-conversation-btn" 
                                            data-conversation-id="@conversation.ConversationId" 
                                            data-bs-toggle="tooltip" 
                                            title="Delete conversation">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="list-group-item p-4 text-center">
                                <div class="text-muted mb-3">
                                    <i class="fas fa-comments fa-2x"></i>
                                </div>
                                <p class="mb-0">No conversations yet.</p>
                                <small>Start a conversation by finding peers.</small>
                            </div>
                        }
                    </div>
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("FindPeers", "PeerSupport")" class="btn btn-primary w-100" style="background-color: #004085; border-color: #004085;">
                        <i class="fas fa-search me-1"></i> Find Peers
                    </a>
                </div>
            </div>
        </div>

        <!-- Active Conversation -->
        <div class="col-md-8 col-lg-9">
            @if (Model.ActiveConversation != null)
            {
                <div class="card shadow h-100 d-flex flex-column">
                    <div class="card-header py-3" style="background-color: #004085; color: white;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <div class="avatar-circle me-2" style="background-color: @GetRandomColor(Model.ActiveConversation.OtherUserId)">
                                    <span class="initials">@(Model.ActiveConversation.OtherUserName.Substring(0, 1).ToUpper())</span>
                                </div>
                                <h5 class="mb-0">
                                    @if (!string.IsNullOrEmpty(Model.ActiveConversation.MoodIcon))
                                    {
                                        <span class="me-1">@Model.ActiveConversation.MoodIcon</span>
                                    }
                                    @Model.ActiveConversation.OtherUserName
                                    @if (Model.ActiveConversation.IsOnline)
                                    {
                                        <span class="online-indicator ms-2" title="Online"></span>
                                    }
                                </h5>
                            </div>
                            <div>
                                <button class="btn btn-sm btn-light" id="emoji-button" title="Insert emoji">
                                    <i class="fas fa-smile"></i>
                                </button>
                                <button class="btn btn-sm btn-light ms-2" id="clear-conversation" title="Clear chat history">
                                    <i class="fas fa-eraser"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-0 flex-grow-1 d-flex flex-column">
                        <div class="messages-container flex-grow-1 p-3" id="messages-container">
                            @{
                                DateTime currentDate = Model.ActiveConversation.Messages.First().CreatedAt.Date;
                            }
                            @if (Model.ActiveConversation.Messages.Any())
                            {
                                <div class="conversation-date-divider">
                                    <span>@Model.ActiveConversation.Messages.First().CreatedAt.ToString("MMMM d, yyyy")</span>
                                </div>

                               

                                @foreach (var message in Model.ActiveConversation.Messages)
                                {
                                    @if (message.CreatedAt.Date != currentDate)
                                    {
                                        <div class="conversation-date-divider">
                                            <span>@message.CreatedAt.ToString("MMMM d, yyyy")</span>
                                        </div>
                                        currentDate = message.CreatedAt.Date;
                                    }

                                    <div class="message-wrapper @(message.IsFromCurrentUser ? "justify-content-end" : "")">
                                        <div class="message @(message.IsFromCurrentUser ? "message-sent" : "message-received")" id="message-@message.MessageId">
                                            <div class="message-content">
                                                <div class="message-header">
                                                    @if (!message.IsFromCurrentUser)
                                                    {
                                                        <span class="message-sender">
                                                            @if (!string.IsNullOrEmpty(message.SenderMoodIcon))
                                                            {
                                                                <span class="me-1">@message.SenderMoodIcon</span>
                                                            }
                                                            @message.SenderName
                                                        </span>
                                                    }
                                                    <small class="message-time">@message.CreatedAt.ToString("h:mm tt")</small>
                                                </div>
                                                <p class="mb-0">@message.Content</p>
                                                @if (message.IsFromCurrentUser)
                                                {
                                                    <div class="message-actions">
                                                        <button class="btn btn-sm text-danger delete-message-btn" 
                                                                data-message-id="@message.MessageId" 
                                                                data-bs-toggle="tooltip" 
                                                                title="Delete message">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center text-muted py-5">
                                    <div class="mb-3">
                                        <i class="fas fa-comments fa-3x"></i>
                                    </div>
                                    <h5>No messages yet</h5>
                                    <p>Start the conversation by sending a message!</p>
                                </div>
                            }
                        </div>
                        <div id="emoji-picker" class="d-none">
                            <div class="emoji-container">
                                @foreach (var emoji in new[] { "😊", "😂", "❤️", "👍", "🙏", "✨", "🎉", "🌟", "💪", "🤗", "😎", "🤔", "😇", "🥳", "👋", "🙌", "💯", "🔥", "👏", "😃" })
                                {
                                    <span class="emoji" data-emoji="@emoji">@emoji</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <form id="message-form" class="message-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="currentUserId" value="@User.FindFirstValue(ClaimTypes.NameIdentifier)" />
                            <input type="hidden" id="conversation-id" value="@Model.ActiveConversation.ConversationId" />
                            <input type="hidden" id="recipient-id" value="@Model.ActiveConversation.OtherUserId" />

                            <div class="input-group">
                                <input type="text" id="message-input" class="form-control" placeholder="Type your message..." required autocomplete="off" />
                                <button type="submit" id="send-button" class="btn btn-primary" style="background-color: #004085; border-color: #004085;">
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            </div>
                            <div id="message-error" class="text-danger mt-2"></div>
                            <div id="sending-indicator" class="text-muted mt-2 d-none">
                                <small><i class="fas fa-spinner fa-spin"></i> Sending message...</small>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow h-100">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center text-center p-5">
                        <i class="fas fa-comments fa-5x mb-4" style="color: #004085;"></i>
                        <h3>Welcome to MindCare Chat</h3>
                        <p class="text-muted mb-4">Select a conversation from the list or start a new one by finding peers.</p>
                        <a href="@Url.Action("FindPeers", "PeerSupport")" class="btn btn-lg btn-primary" style="background-color: #004085; border-color: #004085;">
                            <i class="fas fa-search me-2"></i> Find Peers
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #004085; color: white;">
                <h5 class="modal-title" id="deleteConfirmModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="delete-confirm-text">Are you sure you want to delete this item?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirm-delete-btn">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --primary-color: #004085;
            --primary-light: #cce5ff;
            --primary-dark: #002752;
            --gray-light: #f8f9fa;
            --gray-med: #e9ecef;
            --text-muted: #6c757d;
            --danger: #dc3545;
        }

        .card {
            border-radius: 0.75rem;
            border: none;
            overflow: hidden;
        }

        .conversation-list {
            max-height: 70vh;
            overflow-y: auto;
            scrollbar-width: thin;
        }

        .conversation-item {
            position: relative;
        }

        .conversation-item:hover .delete-conversation-btn {
            opacity: 1;
        }

        .delete-conversation-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            opacity: 0;
            transition: opacity 0.2s ease;
            z-index: 10;
            width: 30px;
            height: 30px;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        .list-group-item {
            border-left: none;
            border-right: none;
            padding: 12px 15px;
            transition: all 0.2s ease;
        }

        .list-group-item:first-child {
            border-top: none;
        }

        .list-group-item:hover {
            background-color: rgba(0, 64, 133, 0.05);
        }

        .list-group-item.active {
            background-color: rgba(0, 64, 133, 0.1);
            color: var(--primary-color);
            border-color: rgba(0, 64, 133, 0.2);
            font-weight: 500;
        }

        .online-indicator {
            display: inline-block;
            width: 8px;
            height: 8px;
            background-color: #28a745;
            border-radius: 50%;
        }

        .avatar-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        .initials {
            font-size: 18px;
        }

        .message-preview {
            font-size: 0.85rem;
            margin-top: 3px;
        }

        .message-time {
            font-size: 0.75rem;
            white-space: nowrap;
        }

        .messages-container {
            height: calc(70vh - 120px);
            overflow-y: auto;
            background-color: var(--gray-light);
            padding: 1rem;
            display: flex;
            flex-direction: column;
            scrollbar-width: thin;
        }

        .message-wrapper {
            display: flex;
            width: 100%;
            margin-bottom: 15px;
        }

        .message {
            max-width: 75%;
            animation: fadeIn 0.3s ease;
            position: relative;
        }

        .message:hover .message-actions {
            opacity: 1;
        }

        .message-actions {
            position: absolute;
            top: 5px;
            right: 5px;
            opacity: 0;
            transition: opacity 0.2s ease;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .message-content {
            padding: 10px 15px;
            border-radius: 18px;
            position: relative;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }

        .message-sent .message-content {
            background-color: var(--primary-color);
            color: white;
            border-bottom-right-radius: 5px;
            padding-right: 28px; /* Space for delete button */
        }

        .message-received .message-content {
            background-color: white;
            border-bottom-left-radius: 5px;
        }

        .message-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
            font-size: 0.8rem;
        }

        .message-sent .message-header {
            color: rgba(255,255,255,0.8);
        }

        .message-time {
            font-size: 0.7rem;
            opacity: 0.7;
        }

        .message-sender {
            font-weight: 500;
        }

        .message-form {
            position: relative;
        }

        .conversation-date-divider {
            display: flex;
            align-items: center;
            margin: 20px 0;
            color: var(--text-muted);
            font-size: 0.8rem;
            text-align: center;
        }

        .conversation-date-divider::before,
        .conversation-date-divider::after {
            content: "";
            flex: 1;
            border-bottom: 1px solid var(--gray-med);
        }

        .conversation-date-divider::before {
            margin-right: 10px;
        }

        .conversation-date-divider::after {
            margin-left: 10px;
        }

        #emoji-picker {
            position: absolute;
            bottom: 70px;
            right: 20px;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            z-index: 1000;
        }

        .emoji-container {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            padding: 10px;
        }

        .emoji {
            font-size: 24px;
            cursor: pointer;
            text-align: center;
            padding: 5px;
            border-radius: 5px;
            transition: background-color 0.2s;
        }

        .emoji:hover {
            background-color: var(--gray-light);
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: var(--gray-light);
        }

        ::-webkit-scrollbar-thumb {
            background-color: var(--text-muted);
            border-radius: 10px;
        }

        /* Responsive adjustments */
        @@media (max-width: 767.98px) {
            .messages-container {
                height: 50vh;
            }
            
            .message {
                max-width: 85%;
            }
        }
    </style>
}

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        $(document).ready(function () {
            // Initialize variables
            const conversationId = '@(Model.ActiveConversation?.ConversationId.ToString() ?? string.Empty)';
            const currentUserId = $('#currentUserId').val();
            let connection = null;
            let connectionEstablished = false;
            let deleteType = null;
            let deleteId = null;
            let messageCache = new Map();
            let typingTimeout = null;
            let lastScrollPosition = 0;

            // Initialize tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl, {
                    boundary: document.body
                });
            });

            // Make sure messages container scrolls to bottom on load
            const scrollToBottom = function(force = false) {
                const container = document.getElementById('messages-container');
                if (container) {
                    // If we're already near the bottom or force scrolling
                    if (force || container.scrollHeight - container.scrollTop - container.clientHeight < 100) {
                        container.scrollTop = container.scrollHeight;
                    }
                }
            };

            // Throttle the scroll function for better performance
            const throttle = (func, delay) => {
                let lastCall = 0;
                return function(...args) {
                    const now = new Date().getTime();
                    if (now - lastCall < delay) {
                        return;
                    }
                    lastCall = now;
                    return func(...args);
                }
            };

            // Save scroll position
            const saveScrollPosition = function() {
                const container = document.getElementById('messages-container');
                if (container) {
                    lastScrollPosition = container.scrollTop;
                }
            };

            // Restore scroll position
            const restoreScrollPosition = function() {
                const container = document.getElementById('messages-container');
                if (container && lastScrollPosition > 0) {
                    container.scrollTop = lastScrollPosition;
                }
            };

            // Format date for message display
            const formatMessageDate = function(date) {
                const now = new Date();
                const messageDate = new Date(date);
                
                if (messageDate.toDateString() === now.toDateString()) {
                    return messageDate.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                } else if (messageDate > new Date(now - 86400000 * 7)) {
                    const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
                    return days[messageDate.getDay()];
                } else {
                    return messageDate.toLocaleDateString();
                }
            };

            // Initial setup
            scrollToBottom(true);
            
            // Handle scroll to implement lazy loading if needed
            $('#messages-container').on('scroll', throttle(function() {
                const container = $(this);
                const scrollTop = container.scrollTop();
                
                // If we're near the top, we could implement loading more messages
                if (scrollTop < 50) {
                    // saveScrollPosition();
                    // TODO: Load older messages
                    // Then restore position after load: restoreScrollPosition();
                }
            }, 200));

            // Set up lazy loading for message content
            const setupLazyLoading = function() {
                const options = {
                    root: document.querySelector('#messages-container'),
                    rootMargin: '0px',
                    threshold: 0.1
                };
                
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const messageEl = entry.target;
                            // Here you can load more content or apply animations
                            observer.unobserve(messageEl);
                        }
                    });
                }, options);
                
                document.querySelectorAll('.message').forEach(message => {
                    observer.observe(message);
                });
            };

            // Initialize lazy loading
            if ('IntersectionObserver' in window) {
                setupLazyLoading();
            }

            // Set up SignalR connection
            const startSignalR = function() {
                // Create connection with retry mechanism
                connection = new signalR.HubConnectionBuilder()
                    .withUrl("/messageHub")
                    .withAutomaticReconnect([0, 2000, 5000, 10000, 15000, 30000])
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                // Join the conversation group when connection starts
                connection.start().then(function () {
                    console.log("SignalR Connected!");
                    connectionEstablished = true;

                    if (conversationId) {
                        connection.invoke("JoinConversation", conversationId)
                            .then(function() {
                                console.log("Joined conversation:", conversationId);
                                // Mark messages as read on connection
                                connection.invoke("MarkConversationAsRead", conversationId)
                                    .catch(function(err) {
                                        console.error("Error marking conversation as read:", err);
                                    });
                            })
                            .catch(function(err) {
                                console.error("Error joining conversation:", err);
                            });
                    }
                }).catch(function (err) {
                    console.error("SignalR Connection Error:", err);
                    setTimeout(startSignalR, 5000); // Try to reconnect after 5 seconds
                });

                // Handle receiving messages
                connection.on("ReceiveMessage", function (messageId, senderId, senderName, senderMoodIcon, content, createdAt) {
                    console.log("Received message via SignalR:", messageId);

                    // Avoid duplicates using message cache
                    if (!messageCache.has(messageId)) {
                        messageCache.set(messageId, true);
                        appendMessage(messageId, senderId, senderName, senderMoodIcon, content, createdAt);
                        
                        // If the message is not from current user, play sound and mark as read
                        if (senderId !== currentUserId) {
                            playNotificationSound();
                            
                            // Mark as read if the conversation is active
                            if (conversationId) {
                                connection.invoke("MarkMessageAsRead", messageId)
                                    .catch(function(err) {
                                        console.error("Error marking message as read:", err);
                                    });
                            }
                        }
                    }
                });

                // Handle message deleted
                connection.on("MessageDeleted", function (messageId) {
                    console.log("Message deleted via SignalR:", messageId);
                    $(`#message-${messageId}`).closest('.message-wrapper').fadeOut(300, function() {
                        $(this).remove();
                    });
                });

                // Handle conversation deleted
                connection.on("ConversationDeleted", function (deletedConversationId) {
                    console.log("Conversation deleted via SignalR:", deletedConversationId);
                    
                    // If it's the active conversation, redirect to messages home
                    if (conversationId === deletedConversationId) {
                        window.location.href = '@Url.Action("DirectMessages", "PeerSupport")';
                    } else {
                        // Otherwise just remove from the list
                        $(`.conversation-item[data-conversation-id="${deletedConversationId}"]`).fadeOut(300, function() {
                            $(this).remove();
                        });
                    }
                });

                // Handle user typing
                connection.on("UserIsTyping", function (userId, userName) {
                    if (userId !== currentUserId) {
                        showTypingIndicator(userName);
                    }
                });

                // Handle connection closed
                connection.onclose(function(error) {
                    console.log("SignalR connection closed", error);
                    connectionEstablished = false;
                    setTimeout(startSignalR, 2000); // Try to reconnect after 2 seconds
                });
            };

            // Function to append a message to the conversation
            const appendMessage = function(messageId, senderId, senderName, senderMoodIcon, content, createdAt) {
                // Format the date
                const date = new Date(createdAt);
                const formattedTime = date.toLocaleString('en-US', { hour: 'numeric', minute: 'numeric', hour12: true });
                const formattedDate = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
                
                // Check if this is from the current user or someone else
                const isFromCurrentUser = (senderId === currentUserId);
                const messageClass = isFromCurrentUser ? "message-sent" : "message-received";
                
                // Check if we need to add a date divider
                const container = $("#messages-container");
                const lastDateDivider = container.find('.conversation-date-divider:last').text().trim();
                
                if (lastDateDivider !== formattedDate) {
                    container.append(`
                        <div class="conversation-date-divider">
                            <span>${formattedDate}</span>
                        </div>
                    `);
                }

                // Create message HTML
                let messageHtml = `
                    <div class="message-wrapper ${isFromCurrentUser ? 'justify-content-end' : ''}">
                        <div class="message ${messageClass}" id="message-${messageId}">
                            <div class="message-content">
                                <div class="message-header">`;

                // Only show sender info if it's not from current user
                if (!isFromCurrentUser) {
                    messageHtml += `
                        <span class="message-sender">`;

                    if (senderMoodIcon) {
                        messageHtml += `<span class="me-1">${senderMoodIcon}</span>`;
                    }

                    messageHtml += `${senderName}</span>`;
                }

                messageHtml += `
                            <small class="message-time">${formattedTime}</small>
                        </div>
                        <p class="mb-0">${content}</p>`;

                // Add delete button only for current user's messages
                if (isFromCurrentUser) {
                    messageHtml += `
                        <div class="message-actions">
                            <button class="btn btn-sm text-danger delete-message-btn"
                                    data-message-id="${messageId}"
                                    data-bs-toggle="tooltip"
                                    title="Delete message">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>`;
                }

                messageHtml += `
                        </div>
                    </div>
                </div>`;

                // Add message to container
                $("#messages-container").append(messageHtml);
                scrollToBottom(true);

                // Initialize tooltip for the new delete button
                const newTooltip = new bootstrap.Tooltip($(`#message-${messageId} .delete-message-btn`)[0], {
                    boundary: document.body
                });
            };

            // Function to delete a message
            const deleteMessage = function(messageId) {
                $.ajax({
                    type: "POST",
                    url: "/PeerSupport/DeleteMessage",
                    data: {
                        messageId: messageId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        console.log("Message delete response:", response);

                        if (response.success) {
                            $(`#message-${messageId}`).closest('.message-wrapper').fadeOut(300, function() {
                                $(this).remove();
                            });
                        } else {
                            showAlert('danger', response.error || "Failed to delete message");
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error("Error deleting message:", xhr.responseText);
                        showAlert('danger', "Failed to delete message. Please try again.");
                    }
                });
            };

            // Function to delete a conversation
            const deleteConversation = function(conversationId) {
                $.ajax({
                    type: "POST",
                    url: "/PeerSupport/DeleteConversation",
                    data: {
                        conversationId: conversationId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        console.log("Conversation delete response:", response);

                        if (response.success) {
                            // If it's the active conversation, redirect to messages home
                            if (conversationId === $('#conversation-id').val()) {
                                window.location.href = '@Url.Action("DirectMessages", "PeerSupport")';
                            } else {
                                // Otherwise just remove from the list
                                $(`.conversation-item[data-conversation-id="${conversationId}"]`).fadeOut(300, function() {
                                    $(this).remove();
                                });
                            }
                        } else {
                            showAlert('danger', response.error || "Failed to delete conversation");
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error("Error deleting conversation:", xhr.responseText);
                        showAlert('danger', "Failed to delete conversation. Please try again.");
                    }
                });
            };

            // Function to show notifications
            const showAlert = function(type, message) {
                const alertHtml = `
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;

                $('#messages-container').prepend(alertHtml);

                // Auto-dismiss after 5 seconds
                setTimeout(function() {
                    $('.alert').alert('close');
                }, 5000);
            };

            // Function to play notification sound
            const playNotificationSound = function() {
                const audio = new Audio('/sounds/notification.mp3');
                audio.volume = 0.5;
                audio.play().catch(e => console.log("Audio play error:", e));
            };

            // Function to show typing indicator
            const showTypingIndicator = function(userName) {
                // Remove any existing typing indicators
                $('#typing-indicator').remove();

                // Add new typing indicator
                const typingHtml = `
                    <div id="typing-indicator" class="typing-indicator">
                        <small class="text-muted"><em>${userName} is typing...</em></small>
                    </div>`;

                $('#messages-container').append(typingHtml);
                scrollToBottom();

                // Remove typing indicator after 3 seconds
                clearTimeout(typingTimeout);
                typingTimeout = setTimeout(function() {
                    $('#typing-indicator').fadeOut(300, function() {
                        $(this).remove();
                    });
                }, 3000);
            };

            // Function to handle user typing
            const handleUserTyping = throttle(function() {
                if (connectionEstablished && conversationId) {
                    connection.invoke("UserIsTyping", conversationId)
                        .catch(function(err) {
                            console.error("Error sending typing notification:", err);
                        });
                }
            }, 2000); // Send typing notification at most once every 2 seconds

            // Start SignalR connection
            if (conversationId) {
                startSignalR();
            }

            // Handle message form submission
            $("#message-form").on("submit", function(e) {
                e.preventDefault();

                const messageInput = $("#message-input");
                const message = messageInput.val().trim();
                const errorContainer = $("#message-error");
                const sendingIndicator = $("#sending-indicator");
                const sendButton = $("#send-button");
                const conversationId = $("#conversation-id").val();
                const recipientId = $("#recipient-id").val();

                // Clear any previous error messages
                errorContainer.text("");

                // Validate message
                if (!message) {
                    errorContainer.text("Please enter a message.");
                    return false;
                }

                // Show sending indicator and disable button
                sendingIndicator.removeClass("d-none");
                sendButton.prop("disabled", true);

                // Prepare data for submission with correct parameter names
                const formData = new FormData();
                formData.append('Content', message);
                formData.append('ConversationId', conversationId);
                formData.append('RecipientId', recipientId);
                formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());

                $.ajax({
                    type: "POST",
                    url: "/PeerSupport/SendMessage",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(response) {
                        console.log("Server response:", response);

                        if (response.success) {
                            // Clear the input field on success
                            messageInput.val('');
                            errorContainer.text('');

                            // Only append the message if it's not already in the cache
                            if (!messageCache.has(response.messageId)) {
                                messageCache.set(response.messageId, true);

                                // Manually add the message to the UI
                                appendMessage(
                                    response.messageId,
                                    currentUserId,
                                    'You',
                                    '',
                                    response.content,
                                    new Date()
                                );
                            }
                        } else {
                            // Display error message
                            console.error("Server returned error:", response);
                            errorContainer.text(response.error || "Failed to send message.");
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error("AJAX Error:", xhr.status, xhr.statusText);
                        console.error("Response Text:", xhr.responseText);
                        errorContainer.text("Failed to send message. Please try again.");
                    },
                    complete: function() {
                        // Hide sending indicator and enable button
                        sendingIndicator.addClass("d-none");
                        sendButton.prop("disabled", false);
                    }
                });

                return false;
            });

            // Toggle emoji picker
            $("#emoji-button").on("click", function() {
                $("#emoji-picker").toggleClass("d-none");
            });

            // Handle emoji selection
            $(".emoji").on("click", function() {
                const emoji = $(this).data('emoji');
                const messageInput = $("#message-input");
                messageInput.val(messageInput.val() + emoji);
                messageInput.focus();
                $("#emoji-picker").addClass("d-none");
            });

            // Hide emoji picker when clicking outside
            $(document).on("click", function(e) {
                if (!$(e.target).closest("#emoji-button, #emoji-picker").length) {
                    $("#emoji-picker").addClass("d-none");
                }
            });

            // Handle clear conversation button
            $("#clear-conversation").on("click", function() {
                deleteType = "conversation";
                deleteId = $("#conversation-id").val();
                $("#delete-confirm-text").text("Are you sure you want to clear this conversation? All messages will be permanently deleted.");
                $("#deleteConfirmModal").modal("show");
            });

            // Handle message deletion buttons
            $(document).on("click", ".delete-message-btn", function(e) {
                e.preventDefault();
                e.stopPropagation();
                const messageId = $(this).data("message-id");
                deleteType = "message";
                deleteId = messageId;
                $("#delete-confirm-text").text("Are you sure you want to delete this message? This cannot be undone.");
                $("#deleteConfirmModal").modal("show");
            });

            // Handle conversation deletion buttons
            $(document).on("click", ".delete-conversation-btn", function(e) {
                e.preventDefault();
                e.stopPropagation();
                const conversationId = $(this).data("conversation-id");
                deleteType = "conversation";
                deleteId = conversationId;
                $("#delete-confirm-text").text("Are you sure you want to delete this entire conversation? All messages will be permanently deleted.");
                $("#deleteConfirmModal").modal("show");
            });

            // Handle delete confirmation
            $("#confirm-delete-btn").on("click", function() {
                if (deleteType === "message" && deleteId) {
                    deleteMessage(deleteId);
                } else if (deleteType === "conversation" && deleteId) {
                    deleteConversation(deleteId);
                }

                $("#deleteConfirmModal").modal("hide");
                deleteType = null;
                deleteId = null;
            });

            // Handle refresh conversations button
            $("#refresh-conversations").on("click", function() {
                $(this).addClass("fa-spin");

                $.ajax({
                    type: "GET",
                    url: "/PeerSupport/RefreshConversations",
                    success: function(response) {
                        if (response.success) {
                            // Reload the conversation list
                            $("#conversation-list").html(response.html);
                        } else {
                            console.error("Error refreshing conversations:", response.error);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error("AJAX Error:", xhr.status, xhr.statusText);
                    },
                    complete: function() {
                        $("#refresh-conversations").removeClass("fa-spin");
                    }
                });
            });

            // Monitor typing in message input
            $("#message-input").on("input", function() {
                handleUserTyping();
            });

            // Mark messages as read when user views them
            if (conversationId) {
                // Create intersection observer to detect when messages come into view
                const markAsReadObserver = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const messageEl = entry.target;
                            const messageId = messageEl.id.replace('message-', '');
                            const isFromCurrentUser = messageEl.classList.contains('message-sent');

                            // Only mark as read if it's not from current user
                            if (!isFromCurrentUser && connectionEstablished) {
                                connection.invoke("MarkMessageAsRead", messageId)
                                    .catch(err => console.error("Error marking message as read:", err));

                                // Stop observing this message
                                markAsReadObserver.unobserve(messageEl);
                            }
                        }
                    });
                }, { threshold: 0.5 });

                // Start observing received messages
                document.querySelectorAll('.message-received').forEach(message => {
                    markAsReadObserver.observe(message);
                });
            }
        });

        // Helper function to generate random color based on user ID
        function getRandomColor(userId) {
            // Use a hash function to get a consistent color for the same user ID
            const hash = Array.from(userId.toString()).reduce(
                (hash, char) => ((hash << 5) - hash) + char.charCodeAt(0), 0);

            // List of nice, professional colors
            const colors = [
                '#004085', '#0069d9', '#17a2b8', '#28a745', '#fd7e14',
                '#6f42c1', '#e83e8c', '#dc3545', '#20c997', '#6c757d'
            ];

            // Use the hash to pick a color
            const index = Math.abs(hash) % colors.length;
            return colors[index];
        }

        // Helper function to format time
        function formatTime(dateTime) {
            if (!dateTime) return "No messages yet";

            const date = new Date(dateTime);
            const now = new Date();
            const yesterday = new Date(now);
            yesterday.setDate(yesterday.getDate() - 1);

            // Today
            if (date.toDateString() === now.toDateString()) {
                return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            }
            // Yesterday
            else if (date.toDateString() === yesterday.toDateString()) {
                return 'Yesterday';
            }
            // This week
            else if (now - date < 7 * 24 * 60 * 60 * 1000) {
                return date.toLocaleDateString([], { weekday: 'short' });
            }
            // Older
            else {
                return date.toLocaleDateString([], { month: 'short', day: 'numeric' });
            }
        }
    </script>
}