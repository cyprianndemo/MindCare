@model Feedback
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Feedback</title>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container my-5">
        <h1 class="text-center" style="color: #004085;">Your Feedback</h1>
        <form asp-action="Create" method="post" class="mt-4">
            <div class="form-group">
                <label for="TherapistId">Select Therapist/Psychiatrist</label>
                <select class="form-control" id="TherapistId" asp-for="TherapistId" asp-items="ViewBag.Therapists" required>
                    <option value="">-- Select Therapist --</option>
                </select>
            </div>
            <div class="form-group">
                <label for="Content">Your Feedback</label>
                <textarea class="form-control" id="Content" asp-for="Content" rows="4" required></textarea>
            </div>
            <div class="form-group">
                <label for="Rating">Rating (1-5)</label>
                <input type="number" class="form-control" id="Rating" asp-for="Rating" min="1" max="5" required>
            </div>
            <button type="submit" class="btn" style="background-color: #004085; color: #fff;">Submit Feedback</button>
        </form>
    </div>
</body>
</html>