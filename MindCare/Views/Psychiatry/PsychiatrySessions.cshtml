@model IEnumerable<Appointment>
@{
    ViewData["Title"] = "Psychiatry Sessions";
    Layout = "_StudentLayout";
    var currentStatus = ViewBag.CurrentStatus ?? "All";
}
<div class="container my-5">
    <h1 class="text-center" style="color: #004085;">Your Psychiatry Sessions</h1>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="btn-group" role="group" aria-label="Session status filter">
            <a href="@Url.Action("PsychiatrySessions", "Psychiatry", new { status = "All" })"
               class="btn" style="background-color: @(currentStatus == "All" ? "#004085" : "#004085"); color: #fff; border-color: #004085;">
                All Sessions
            </a>
            <a href="@Url.Action("PsychiatrySessions", "Psychiatry", new { status = "Pending" })"
               class="btn" style="background-color: @(currentStatus == "Pending" ? "#004085" : "#004085");color: #fff; border-color: #004085;">
                Pending Sessions
            </a>
            <a href="@Url.Action("PsychiatrySessions", "Psychiatry", new { status = "Approved" })"
               class="btn" style="background-color: @(currentStatus == "Approved" ? "#004085" : "#004085");color: #fff; border-color: #004085;">
                Confirmed Sessions
            </a>
        </div>
        <a href="@Url.Action("BookSession", "Psychiatry")" class="btn" style="background-color: #004085; color: #fff;">
            Book Session
        </a>
    </div>
    <div class="list-group">
        @if (!Model.Any())
        {
            <div class="alert alert-info">
                @if (currentStatus == "All")
                {
                    <span>You don't have any scheduled Psychiatry sessions yet.</span>
                }
                else
                {
                    <span>You don't have any @currentStatus.ToLower() Psychiatry sessions.</span>
                }
            </div>
        }
        else
        {
            @foreach (var session in Model)
            {
                <div class="list-group-item">
                    <div class="d-flex w-100 justify-content-between align-items-center">
                        <a href="@Url.Action("SessionDetails", "Psychiatry", new { id = session.AppointmentId })"
                           class="flex-grow-1 text-decoration-none text-dark">
                            <div class="d-flex w-100 justify-content-between">
                                <h5 class="mb-1">@session.GetLocalStartTime().ToShortDateString() @session.GetLocalStartTime().ToString("HH:mm")</h5>
                                <span class="badge @(session.Status == "Pending" ? "badge-warning" :
                                               session.Status == "Approved" ? "badge-success" :
                                               session.Status == "Cancelled" ? "badge-danger" : "badge-secondary")">
                                    @session.Status
                                </span>
                            </div>
                            <p class="mb-1">Psychiatrist: @(session.Psychiatrist?.FirstName ?? "") @(session.Psychiatrist?.LastName ?? "Not Assigned")</p>
                            <small class="text-muted">Click for details</small>
                        </a>
                        <div class="ml-3 d-flex">
                            @if (session.Status != "Cancelled")
                            {
                                <a href="@Url.Action("Edit", "Psychiatry", new { id = session.AppointmentId })" 
                                   class="btn btn-sm btn-outline-primary mr-2" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                            }
                            <form asp-action="Delete" asp-controller="Psychiatry" method="post" 
                                  onsubmit="return confirm('Are you sure you want to delete this appointment? This action cannot be undone.');">
                                <input type="hidden" name="id" value="@session.AppointmentId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Optional: Add this to your _Layout.cshtml if you haven't already included Font Awesome -->
@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
}