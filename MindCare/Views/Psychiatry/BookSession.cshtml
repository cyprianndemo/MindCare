@model Appointment
@{
    ViewData["Title"] = "Book Psychiatry Session";
}
<div class="container">
    <h2>Book Psychiatry Session</h2>
    <div class="mb-3">
        <strong>Booking for:</strong> @ViewBag.UserEmail
    </div>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <strong>Error:</strong>
            <ul>
                @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@modelError.ErrorMessage</li>
                }
            </ul>
        </div>
    }
    <form asp-action="BookSession" method="post" id="bookingForm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @* Add hidden field for StudentId *@
        <input type="hidden" asp-for="StudentId" value="@ViewBag.StudentId" />

        <div class="form-group mb-3">
            <label asp-for="PsychiatristId" class="control-label">Select Psychiatrist</label>
            <select asp-for="PsychiatristId" class="form-select" asp-items="ViewBag.Psychiatrists" required>
                <option value="">Select a Psychiatrist...</option>
            </select>
            <span asp-validation-for="PsychiatristId" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Date" class="control-label">Appointment Date</label>
            <input asp-for="Date" class="form-control" type="date"
                   min="@DateTime.Today.ToString("yyyy-MM-dd")"
                   required />
            <span asp-validation-for="Date" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Time" class="control-label">Appointment Time</label>
            <input asp-for="Time" class="form-control" type="time"
                   min="09:00" max="17:00" step="3600"
                   required />
            <span asp-validation-for="Time" class="text-danger"></span>
            <small class="form-text text-muted">Available hours: 9 AM - 5 PM, weekdays only</small>
        </div>
        <div class="form-group mt-3">
            <button type="submit" class="btn" style="background-color: #004085; color: #fff;">Book Appointment</button>
            <a asp-action="PsychiatrySessions" class="btn" style="background-color: #004085; color: #fff;">Back to List</a>
        </div>
    </form>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            // Client-side validation
            $("#bookingForm").submit(function (e) {
                var Psychiatrist = $("#PsychiatristId").val();
                var date = $("#Date").val();
                var time = $("#Time").val();
                var isValid = true;
                if (!Psychiatrist) {
                    alert("Please select a Psychiatrist");
                    isValid = false;
                }
                if (!date) {
                    alert("Please select a date");
                    isValid = false;
                }
                if (!time) {
                    alert("Please select a time");
                    isValid = false;
                }
                // Validate business hours (9 AM - 5 PM)
                if (time) {
                    var hours = parseInt(time.split(":")[0]);
                    if (hours < 9 || hours >= 17) {
                        alert("Please select a time between 9 AM and 5 PM");
                        isValid = false;
                    }
                }
                // Validate weekdays only
                if (date) {
                    var selectedDate = new Date(date);
                    if (selectedDate.getDay() === 0 || selectedDate.getDay() === 6) {
                        alert("Please select a weekday (Monday-Friday)");
                        isValid = false;
                    }
                }
                if (!isValid) {
                    e.preventDefault();
                }
            });
        });
    </script>
}