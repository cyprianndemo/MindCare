@model MindCare.Models.Appointment

@{
    ViewData["Title"] = "Session Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Session Details</title>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f5f8fa;
            color: #333;
            font-family: Arial, sans-serif;
        }

        .text-primary {
            color: #004085;
        }

        .btn-custom {
            background-color: #004085;
            color: #fff;
        }

        .btn-custom:hover {
            background-color: #002752;
            color: #fff;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <h2 class="text-center text-primary mb-4">Session Details</h2>
        
        @if (Model != null)
        {
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Appointment Information</h5>
                    
                    <p><strong>Psychiatrist:</strong> @Model.Psychiatrist.FirstName @Model.Psychiatrist.LastName</p>
                    <p><strong>Date:</strong> @Model.StartTime.ToLocalTime().ToString("dd/MM/yyyy")</p>
                    <p><strong>Time:</strong> @Model.StartTime.ToLocalTime().ToString("HH:mm") - @Model.EndTime.ToLocalTime().ToString("HH:mm")</p>
                    <p><strong>Status:</strong> <span class="text-@(Model.Status == "Cancelled" ? "danger" : "success")">@Model.Status</span></p>

                    <!-- Buttons Section -->
                    <div class="mt-4 text-right">
                        <!-- Edit Appointment Button -->
                        <a href="@Url.Action("Edit", "Psychiatry", new { id = Model.AppointmentId })" class="btn btn-custom mr-2">Edit Appointment</a>

                        <!-- Cancel Appointment Button -->
                        <form action="@Url.Action("Cancel", "Psychiatry", new { id = Model.AppointmentId })" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-custom">Cancel Appointment</button>
                        </form>
                    </div>

                    @if (Model.Status == "Pending" || Model.Status == "Confirmed")
                    {
                        <div class="mt-3">
                            <a href="@ViewBag.VideoCallLink" target="_blank" class="btn btn-custom">
                                <i class="bi bi-camera-video"></i> Start Video Call
                            </a>
                        </div>
                    }
                    else
                    {
                        <p class="text-danger mt-3">The session must be confirmed or pending to start a video call.</p>
                    }
                </div>
            </div>

            <!-- Back to Sessions Button -->
            <div class="text-center mt-4">
                <a href="@Url.Action("PsychiatrySessions", "Psychiatry")" class="btn btn-custom">Back to Sessions</a>
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center" role="alert">
                Appointment not found.
            </div>
        }
    </div>
</body>
</html>
