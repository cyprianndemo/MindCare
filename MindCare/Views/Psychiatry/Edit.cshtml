@model MindCare.Models.Appointment

    <div class="container my-5">
        <h1 class="text-center text-primary mb-4">Edit Your Appointment</h1>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="AppointmentId" />            

            <div class="form-group">
                <label for="PsychiatristId">Select Psychiatrist</label>
                <select asp-for="PsychiatristId" class="form-control" asp-items="ViewBag.Psychiatrists"></select>
            </div>

            <div class="form-group">
                <label for="Date">Date</label>
                <input type="date" asp-for="Date" class="form-control" />
            </div>

            <div class="form-group">
                <label for="Time">Time</label>
                <input type="time" asp-for="Time" class="form-control" />
            </div>

            <div class="form-group">
                <button type="submit" class="btn" style="background-color: #004085; color: #fff;">Save Changes</button>
            </div>
        </form>

        <div class="text-center mt-3">
            <a href="@Url.Action("TherapySessions", "Therapy")" class="btn" style="background-color: #004085; color: #fff;">Back to Sessions</a>
        </div>
    </div>
