@model IEnumerable<CartItem>

    <div class="container my-5">
        <h1 class="text-center" style="color: #004085;">Your Cart</h1>
        <table class="table mt-4">
            <thead>
                <tr>
                    <th>Medication</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Subtotal</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Medication.Name</td>
                        <td>@item.Quantity</td>
                        <td>@item.Medication.Price</td>
                        <td>@(item.Quantity * item.Medication.Price)</td>
                        <td><a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.CartItemId })" class="btn btn-danger btn-sm">Remove</a></td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="text-right">
            <a href="@Url.Action("Pay", "Checkout")" class="btn" style="background-color: #004085; color: #fff;">Proceed to Checkout</a>
        </div>
    </div>

