@model MindCare.PsychiatristReport.PsychiatristReportViewModel
@{
    ViewData["Title"] = "Psychiatrist Report";
    Layout = "_PsychiatristLayout";
}
<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header text-white" style="background-color: #004085;">
            <h2 class="mb-0">Psychiatrist Report</h2>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h3>@Model.PsychiatristName</h3>
                    <p class="text-muted">Report generated on: @Model.GeneratedDate.ToString("MMMM dd, yyyy HH:mm")</p>
                </div>
                <div class="col-md-6 text-md-right">
                    <button class="btn btn-outline-primary" onclick="window.print()">
                        <i class="fas fa-print"></i> Print Report
                    </button>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h5 class="card-title">Total Sessions</h5>
                            <h2 class="display-4">@Model.TotalSessions</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h5 class="card-title">Pending Sessions</h5>
                            <h2 class="display-4">@Model.PendingSessions</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h5 class="card-title">Approved Sessions</h5>
                            <h2 class="display-4">@Model.ApprovedSessions</h2>
                        </div>
                    </div>
                </div>
            </div>

            <h4 class="mb-3">Prescribed Medications</h4>
            @if (Model.Prescriptions != null && Model.Prescriptions.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead style="background-color: #004085; color: #fff;">
                            <tr>
                                <th>Student Name</th>
                                <th>Medication</th>
                                <th>Dosage</th>
                                <th>Prescribed Date</th>
                                <th>Instructions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prescription in Model.Prescriptions)
                            {
                                <tr>
                                    <td>@prescription.StudentName</td>
                                    <td>@prescription.MedicationName</td>
                                    <td>@prescription.Dosage</td>
                                    <td>@prescription.PrescriptionDate.ToString("MM/dd/yyyy")</td>
                                    <td>@prescription.Instructions</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    No medications have been prescribed yet.
                </div>
            }
        </div>
        <div class="card-footer text-muted">
            <small>This report is confidential and intended only for medical professionals.</small>
        </div>
    </div>
</div>