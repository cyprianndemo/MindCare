@model MindCare.ViewModel.ResourceReadViewModel
@{
    ViewData["Title"] = Model.Resource.Title;
}

<div class="container py-5">
    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4 animate__animated animate__fadeIn">
                <div class="card-body p-4">
                    <!-- Resource Header -->
                    <div class="d-flex justify-content-between mb-4">
                        <div>
                            <h1 class="mb-2">@Model.Resource.Title</h1>
                            <div class="d-flex align-items-center">
                                <span class="badge bg-primary me-2">@Model.Resource.Category</span>
                                <span class="badge bg-secondary me-2">@Model.Resource.ResourceType</span>
                                <span class="text-muted small">
                                    <i class="bi bi-eye me-1"></i> @Model.Resource.ViewCount views
                                </span>
                            </div>
                        </div>
                        <!-- Bookmark & Share -->
                        <div>
                            <button class="btn btn-outline-primary btn-sm me-2" id="bookmarkBtn">
                                <i class="bi bi-bookmark"></i> Save
                            </button>
                            <div class="dropdown d-inline-block">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle"
                                        type="button" id="shareDropdown" data-bs-toggle="dropdown">
                                    <i class="bi bi-share"></i> Share
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-facebook"></i> Facebook</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-twitter"></i> Twitter</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-envelope"></i> Email</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Resource Content -->
                    <div class="resource-content my-4">
                        @Html.Raw(Model.Resource.Content)
                    </div>

                    <!-- Tags -->
                    <div class="mt-4">
                        @foreach (var tag in Model.Resource.Tags)
                        {
                            <a href="@Url.Action("Index", new { searchTerm = tag })"
                               class="badge bg-light text-dark text-decoration-none me-1 p-2">
                                #@tag
                            </a>
                        }
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between mt-4">
                        @if (Model.Resource.IsDownloadable)
                        {
                            <a href="@Model.Resource.FileUrl" class="btn btn-success">
                                <i class="bi bi-download"></i> Download Resource
                            </a>
                        }
                        <button class="btn btn-primary" id="feedbackBtn" data-bs-toggle="modal" data-bs-target="#feedbackModal">
                            <i class="bi bi-star"></i> Rate This Resource
                        </button>
                    </div>
                </div>
            </div>

            <!-- Interactive Exercises Section -->
            @if (Model.RelatedExercises?.Any() == true)
            {
                <div class="card shadow-sm mb-4 animate__animated animate__fadeIn">
                    <div class="card-header bg-light">
                        <h3 class="mb-0">Related Exercises</h3>
                    </div>
                    <div class="card-body">
                        <div class="accordion" id="exercisesAccordion">
                            @foreach (var exercise in Model.RelatedExercises)
                            {
                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#exercise@(exercise.Id)">
                                            @exercise.Title
                                        </button>
                                    </h2>
                                    <div id="exercise@(exercise.Id)" class="accordion-collapse collapse"
                                         data-bs-parent="#exercisesAccordion">
                                        <div class="accordion-body">
                                            <p>@exercise.Description</p>
                                            <div class="exercise-content">
                                                @Html.Raw(exercise.Content)
                                            </div>
                                            <a href="@Url.Action("Exercise", "Resources", new { id = exercise.Id })"
                                               class="btn btn-outline-primary mt-3">
                                                Start Exercise <i class="bi bi-arrow-right"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Comments Section -->
            <div class="card shadow-sm mb-4 animate__animated animate__fadeIn">
                <div class="card-header bg-light">
                    <h3 class="mb-0">Comments & Discussion</h3>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <textarea class="form-control" rows="3" placeholder="Share your thoughts about this resource..."></textarea>
                        <div class="d-flex justify-content-end mt-2">
                            <button class="btn btn-primary">Post Comment</button>
                        </div>
                    </div>
                    <div id="commentsContainer">
                        <!-- Comments will be loaded here -->
                        <div class="text-center py-4">
                            <p class="text-muted">Be the first to comment on this resource</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Professional Resources -->
            @if (Model.ProfessionalResources?.Any() == true)
            {
                <div class="card shadow-sm mb-4 animate__animated animate__fadeIn">
                    <div class="card-header bg-light">
                        <h4 class="mb-0">Professional Help</h4>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var pro in Model.ProfessionalResources)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-1">@pro.Name</h5>
                                        <p class="mb-1 small text-muted">@pro.Specialty</p>
                                    </div>
                                    <span class="badge bg-success">@pro.Type</span>
                                </div>
                                <p class="mb-1 small">@pro.Description</p>
                                <div class="mt-2">
                                    <a href="@pro.ContactUrl" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-telephone"></i> Contact
                                    </a>
                                </div>
                            </div>
                        }
                        <div class="list-group-item text-center">
                            <a href="@Url.Action("Professionals", "Resources")" class="text-decoration-none">
                                View All Professional Resources <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }

            <!-- Related Resources -->
            @if (Model.RelatedResources?.Any() == true)
            {
                <div class="card shadow-sm mb-4 animate__animated animate__fadeIn">
                    <div class="card-header bg-light">
                        <h4 class="mb-0">Related Resources</h4>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var related in Model.RelatedResources)
                        {
                            <a href="@Url.Action("Read", new { id = related.Id })" class="list-group-item list-group-item-action">
                                <div class="d-flex w-100 justify-content-between">
                                    <h5 class="mb-1">@related.Title</h5>
                                    <small class="text-muted">@related.ResourceType</small>
                                </div>
                                <p class="mb-1">@related.Description</p>
                                <small class="text-primary">Read more</small>
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Resource Categories -->
            <div class="card shadow-sm mb-4 animate__animated animate__fadeIn">
                <div class="card-header bg-light">
                    <h4 class="mb-0">Explore Categories</h4>
                </div>
                <div class="card-body">
                    <div class="category-cloud">
                        @foreach (var category in ResourceConstants.Categories.Keys)
                        {
                            <a href="@Url.Action("Index", new { category = category })"
                               class="badge rounded-pill bg-light text-dark border p-2 m-1 text-decoration-none">
                                @category
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- Quick Resources -->
            <div class="card shadow-sm mb-4 animate__animated animate__fadeIn">
                <div class="card-header bg-light">
                    <h4 class="mb-0">Quick Resources</h4>
                </div>
                <div class="list-group list-group-flush">
                    <a href="@Url.Action("Toolbox", "Resources")" class="list-group-item list-group-item-action">
                        <i class="bi bi-tools me-2"></i> Self-help Toolbox
                    </a>
                    <a href="@Url.Action("Crisis", "Resources")" class="list-group-item list-group-item-action">
                        <i class="bi bi-exclamation-triangle me-2"></i> Crisis Support
                    </a>
                    <a href="@Url.Action("Assessment", "Resources")" class="list-group-item list-group-item-action">
                        <i class="bi bi-clipboard-check me-2"></i> Mental Health Assessment
                    </a>
                    <a href="@Url.Action("Professionals", "Resources")" class="list-group-item list-group-item-action">
                        <i class="bi bi-person-badge me-2"></i> Find Professionals
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Feedback Modal -->
<div class="modal fade" id="feedbackModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Rate This Resource</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="feedbackForm">
                    <div class="mb-3 text-center">
                        <div class="rating">
                            <input type="radio" id="star5" name="rating" value="5" />
                            <label for="star5" title="5 stars"></label>
                            <input type="radio" id="star4" name="rating" value="4" />
                            <label for="star4" title="4 stars"></label>
                            <input type="radio" id="star3" name="rating" value="3" />
                            <label for="star3" title="3 stars"></label>
                            <input type="radio" id="star2" name="rating" value="2" />
                            <label for="star2" title="2 stars"></label>
                            <input type="radio" id="star1" name="rating" value="1" />
                            <label for="star1" title="1 star"></label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="feedbackMessage" class="form-label">How helpful was this resource?</label>
                        <textarea class="form-control" id="feedbackMessage" rows="3"></textarea>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="anonymousFeedback">
                        <label class="form-check-label" for="anonymousFeedback">Submit anonymously</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="submitFeedback">Submit Feedback</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <style>
        .resource-content {
            font-size: 1.1rem;
            line-height: 1.7;
        }

            .resource-content h2, .resource-content h3 {
                margin-top: 1.5rem;
                margin-bottom: 1rem;
            }

            .resource-content img {
                max-width: 100%;
                height: auto;
                border-radius: 8px;
                margin: 1rem 0;
            }

            .resource-content blockquote {
                border-left: 4px solid #007bff;
                padding-left: 1rem;
                font-style: italic;
                color: #6c757d;
            }
        /* Star Rating */
        .rating {
            display: flex;
            flex-direction: row-reverse;
            justify-content: center;
        }

            .rating input {
                display: none;
            }

            .rating label {
                cursor: pointer;
                width: 30px;
                height: 30px;
                margin: 0 5px;
                background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="%23ccc" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>');
                background-repeat: no-repeat;
            }

                .rating input:checked ~ label,
                .rating label:hover,
                .rating input:checked + label:hover,
                .rating input:checked ~ label:hover {
                    background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="%23FFD700" stroke="%23FFD700" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>');
                }

        .category-cloud {
            display: flex;
            flex-wrap: wrap;
        }

            .category-cloud a:hover {
                background-color: #007bff !important;
                color: white !important;
            }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // Handle bookmark functionality
            $('#bookmarkBtn').click(function () {
                let icon = $(this).find('i');
                if (icon.hasClass('bi-bookmark')) {
                    icon.removeClass('bi-bookmark').addClass('bi-bookmark-fill');
                    $(this).removeClass('btn-outline-primary').addClass('btn-primary');
                    showToast('Resource saved to your bookmarks');
                } else {
                    icon.removeClass('bi-bookmark-fill').addClass('bi-bookmark');
                    $(this).removeClass('btn-primary').addClass('btn-outline-primary');
                    showToast('Resource removed from your bookmarks');
                }
            });

            // Handle feedback submission
            $('#submitFeedback').click(function () {
                const rating = $('input[name="rating"]:checked').val();
                const feedback = $('#feedbackMessage').val();
                const anonymous = $('#anonymousFeedback').is(':checked');

                // Here you would send this data to your server
                console.log({ rating, feedback, anonymous, resourceId: @Model.Resource.Id});

                $('#feedbackModal').modal('hide');
                showToast('Thank you for your feedback!');
            });

            // Animate elements on scroll
            animateElementsOnScroll();
        });

        function showToast(message) {
            // Create toast if it doesn't exist
            if ($('#toast-container').length === 0) {
                $('body').append(`
                            <div id="toast-container" style="position: fixed; bottom: 20px; right: 20px; z-index: 1050;"></div>
                        `);
            }

            const toastId = 'toast-' + Math.random().toString(36).substr(2, 9);
            const toast = `
                        <div id="${toastId}" class="toast align-items-center text-white bg-primary border-0" role="alert" aria-live="assertive" aria-atomic="true">
                            <div class="d-flex">
                                <div class="toast-body">
                                    ${message}
                                </div>
                                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                            </div>
                        </div>
                    `;

            $('#toast-container').append(toast);

            const toastElement = new bootstrap.Toast(document.getElementById(toastId), {
                delay: 3000
            });
            toastElement.show();
        }

        function animateElementsOnScroll() {
            const elements = document.querySelectorAll('.animate__animated');

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('animate__fadeIn');
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.1 });

            elements.forEach(element => {
                element.classList.remove('animate__fadeIn');
                observer.observe(element);
            });
        }
    </script>
}