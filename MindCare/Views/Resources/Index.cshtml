@model List<MindCare.MentalResources.ResourceCategory>
@{
    ViewBag.Title = "Mental Health Resources";
}

<div class="resources-header">
    <div class="container">
        <h1>Mental Health Resources</h1>
        <p class="lead">Access helpful articles, exercises, and professional resources to support your mental wellbeing.</p>
    </div>
</div>

<div class="container resources-container">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Why Seek Professional Help?</h5>
                    <p>
                        Understanding when and why to seek professional help is an important part of mental health care.
                        Learn about the benefits of therapy and psychiatry.
                    </p>
                    <a href="@Url.Action("WhySeekHelp", "Resources")" class="btn custom-btn">Learn More</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        @foreach (var category in Model)
        {
            <div class="col-md-6 col-lg-3 mb-4">
                <div class="card h-100 resource-category-card">
                    <div class="card-body text-center">
                        <div class="category-icon">
                            <i class="fas @category.IconClass fa-3x"></i>
                        </div>
                        <h5 class="card-title">@category.Name</h5>
                        <p class="card-text">@category.Description</p>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 text-center">
                        <a href="@Url.Action("Category", "Resources", new { id = category.Id })" class="btn" style="background-color: #004085; color: #fff;">
                            Browse @category.Name
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row mt-5">
        <div class="col-md-12">
            <div class="alert alert-info" role="alert">
                <h4 class="alert-heading"><i class="fas fa-info-circle"></i> Important Note</h4>
                <p>
                    The resources provided on this website are for informational purposes only and are not a substitute for professional medical advice,
                    diagnosis, or treatment. If you're experiencing a mental health crisis, please contact a crisis helpline or go to your nearest
                    emergency room.
                </p>
                <hr>
                <p class="mb-0">
                    <strong>Crisis Helpline:</strong> 988 (National Suicide Prevention Lifeline)
                </p>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .resources-header {
            background-color: #f8f9fa;
            padding: 3rem 0;
            margin-bottom: 2rem;
            text-align: center;
        }

        .category-icon {
            margin-bottom: 1.5rem;
            color: #5a67d8;
        }

        .resource-category-card {
            transition: transform 0.3s;
        }

            .resource-category-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            }
                .custom-btn {
        background-color: #004085;
        color: #fff;
        border-color: #004085; 
            }
    </style>
}