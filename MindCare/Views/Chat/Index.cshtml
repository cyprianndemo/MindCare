@model dynamic
@{
    ViewData["Title"] = "Chat";
    Layout = "_StudentLayout";
}

<div class="container my-4">
    <div class="card shadow">
        <div class="card-header text-white" style="background-color: #004085;">
            <h3 class="mb-0">Chat with MindCare Assistant</h3>
        </div>
        <div class="card-body">
            <div class="chat-container">
                <div class="chat-messages" id="messagesList">
                    <!-- Welcome message will be added here -->
                </div>
                <div class="input-group mt-3">
                    <input type="text" id="messageInput" class="form-control" placeholder="Type your message..." />
                    <div class="input-group-append">
                        <button id="sendButton" onclick="sendMessage()" class="btn text-white" style="background-color: #003060;">
                            <i class="fas fa-paper-plane"></i> Send
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .chat-container {
        display: flex;
        flex-direction: column;
        height: 70vh;
    }

    .chat-messages {
        flex-grow: 1;
        overflow-y: auto;
        padding: 15px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .message {
        max-width: 70%;
        padding: 10px 15px;
        border-radius: 15px;
        margin: 5px 0;
        word-wrap: break-word;
    }

    .user-message {
        align-self: flex-end;
        background-color: #004085;
        color: white;
        border-radius: 15px 15px 0 15px;
    }

    .bot-message {
        align-self: flex-start;
        background-color: #e9ecef;
        color: #212529;
        border-radius: 15px 15px 15px 0;
    }

    .message-timestamp {
        font-size: 0.7rem;
        color: rgba(0,0,0,0.5);
        margin-top: 4px;
        text-align: right;
    }

    .bot-message .message-timestamp {
        color: rgba(0,0,0,0.5);
    }

    .user-message .message-timestamp {
        color: rgba(255,255,255,0.7);
    }

    #messageInput {
        border-radius: 20px;
        padding: 10px 20px;
    }

    .typing-indicator {
        display: flex;
        align-items: center;
        align-self: flex-start;
        background-color: #e9ecef;
        color: #212529;
        border-radius: 15px;
        padding: 10px 15px;
    }

        .typing-indicator span {
            height: 8px;
            width: 8px;
            background-color: #3F5EFB;
            border-radius: 50%;
            display: inline-block;
            margin: 0 1px;
            animation: pulse 1.5s infinite ease-in-out;
        }

            .typing-indicator span:nth-child(2) {
                animation-delay: 200ms;
            }

            .typing-indicator span:nth-child(3) {
                animation-delay: 400ms;
            }

    @@keyframes pulse {
        0%

    {
        transform: scale(1);
    }

    50% {
        transform: scale(1.5);
    }

    100% {
        transform: scale(1);
    }

    }

    /* Custom scrollbar */
    .chat-messages::-webkit-scrollbar {
        width: 6px;
    }

    .chat-messages::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .chat-messages::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 3px;
    }

        .chat-messages::-webkit-scrollbar-thumb:hover {
            background: #555;
        }
</style>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        connection.start()
            .then(() => {
                console.log("SignalR connected");
                // Add welcome message
                const welcomeMessage = "Hello! I'm your MindCare Assistant. How can I help you today? You can ask about mental health resources, track your mood, or just chat with me about how you're feeling.";
                appendMessage(welcomeMessage, true);
            })
            .catch(err => console.error("SignalR connection error: ", err));

        // Handle Enter key press
        document.getElementById("messageInput").addEventListener("keypress", function(event) {
            if (event.key === "Enter") {
                event.preventDefault();
                sendMessage();
            }
        });

        connection.on("ReceiveMessage", function (message) {
            // Remove typing indicator if it exists
            const typingIndicator = document.getElementById("typingIndicator");
            if (typingIndicator) {
                typingIndicator.remove();
            }
            appendMessage(message.content, message.isFromBot);
        });

        function appendMessage(content, isFromBot) {
            const messagesDiv = document.getElementById("messagesList");
            const messageElement = document.createElement("div");
            messageElement.classList.add("message", isFromBot ? "bot-message" : "user-message");

            // Create message content with markdown support
            const messageContent = document.createElement("div");
            messageContent.classList.add("message-content");

            // Simple markdown parsing for links
            const markdownText = content.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
            messageContent.innerHTML = markdownText;

            // Create timestamp
            const timestamp = document.createElement("div");
            timestamp.classList.add("message-timestamp");
            timestamp.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            messageElement.appendChild(messageContent);
            messageElement.appendChild(timestamp);

            messagesDiv.appendChild(messageElement);
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
        }

        function showTypingIndicator() {
            const messagesDiv = document.getElementById("messagesList");
            const typingElement = document.createElement("div");
            typingElement.classList.add("typing-indicator");
            typingElement.id = "typingIndicator";

            // Add the dots
            for (let i = 0; i < 3; i++) {
                const dot = document.createElement("span");
                typingElement.appendChild(dot);
            }

            messagesDiv.appendChild(typingElement);
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
        }

        function sendMessage() {
            const input = document.getElementById("messageInput");
            const sendButton = document.getElementById("sendButton");
            const content = input.value.trim();

            if (!content) return;

            // Disable input and button while processing
            input.disabled = true;
            sendButton.disabled = true;

            const userMessage = {
                content: content,
                senderId: "user123", // Replace with actual user ID from your authentication system
                timestamp: new Date(),
                isFromBot: false
            };

            // Display user message
            appendMessage(content, false);

            // Show typing indicator
            showTypingIndicator();

            // Send to server
            fetch('/Chat/SendMessage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(userMessage)
            })
            .then(response => {
                if (!response.ok) throw new Error("Failed to send message");
                return response.json();
            })
            .then(data => {
                // Remove typing indicator
                const typingIndicator = document.getElementById("typingIndicator");
                if (typingIndicator) {
                    typingIndicator.remove();
                }

                if (data && data.message) {
                    appendMessage(data.message, true);
                }
            })
            .catch(error => {
                console.error("Error:", error);

                // Remove typing indicator
                const typingIndicator = document.getElementById("typingIndicator");
                if (typingIndicator) {
                    typingIndicator.remove();
                }

                appendMessage("Sorry, there was an error sending your message. Please try again.", true);
            })
            .finally(() => {
                // Re-enable input and button
                input.disabled = false;
                sendButton.disabled = false;
                input.focus();
            });

            input.value = '';
        }

        // Scroll to bottom when page loads
        window.onload = function() {
            const messagesDiv = document.getElementById("messagesList");
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
        }
    </script>
}