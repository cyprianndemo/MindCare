@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Login with External Providers";
}

<div class="container mt-5 animate__animated animate__fadeIn">
    <h1 class="text-center mb-4">@ViewData["Title"]</h1>
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-4">Sign in with your account</h2>
                    <hr />

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @Model.ErrorMessage
                        </div>
                    }

                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-outline-dark btn-lg d-flex align-items-center justify-content-center gap-2" name="provider" value="Google" title="Log in using your Google account">
                                <img src="~/images/google-logo.png" alt="Google" width="24" height="24" />
                                <span>Sign in with Google</span>
                            </button>

                            <button type="submit" class="btn btn-outline-dark btn-lg d-flex align-items-center justify-content-center gap-2" name="provider" value="GitHub" title="Log in using your GitHub account">
                                <img src="~/images/github-logo.png" alt="GitHub" width="24" height="24" />
                                <span>Sign in with GitHub</span>
                            </button>

                            <button type="submit" class="btn btn-success btn-lg d-flex align-items-center justify-content-center gap-2" name="provider" value="Safaricom" title="Log in using your Safaricom account">
                                <img src="~/images/safaricom-logo.png" alt="Safaricom" width="24" height="24" />
                                <span>Sign in with Safaricom</span>
                            </button>
                        </div>
                    </form>

                    <div class="mt-4 text-center">
                        <p>Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>