@page
@model ExternalLoginRoleSelectionModel
@{
    ViewData["Title"] = "Complete Registration";
}

<div class="container mt-5 animate__animated animate__fadeIn">
    <h1 class="text-center mb-4">@ViewData["Title"]</h1>
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-body p-4">
                    <form asp-page-handler="confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="needs-validation">
                        <h2 class="card-title text-center mb-4">Complete your profile</h2>
                        <p class="text-center">Welcome, @Model.FirstName @Model.LastName (@Model.Email)</p>
                        <hr />
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="form-floating mb-4">
                            <select asp-for="Input.Role" class="form-select" aria-required="true">
                                <option value="">Select a role...</option>
                                <option value="Student">Student</option>
                                <option value="Therapist">Therapist</option>
                                <option value="Psychiatrist">Psychiatrist</option>
                            </select>
                            <label asp-for="Input.Role"></label>
                            <span asp-validation-for="Input.Role" class="text-danger"></span>
                        </div>

                        <!-- Student Fields -->
                        <div id="studentFields" class="animate__animated animate__fadeIn" style="display: none;">
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <div class="form-floating">
                                        <input asp-for="Input.University" class="form-control" />
                                        <label asp-for="Input.University"></label>
                                        <span asp-validation-for="Input.University" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating">
                                        <input asp-for="Input.Course" class="form-control" />
                                        <label asp-for="Input.Course"></label>
                                        <span asp-validation-for="Input.Course" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating">
                                        <input asp-for="Input.YearOfStudy" class="form-control" />
                                        <label asp-for="Input.YearOfStudy"></label>
                                        <span asp-validation-for="Input.YearOfStudy" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Medical Professional Fields -->
                        <div id="medicalFields" class="animate__animated animate__fadeIn" style="display: none;">
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <div class="form-floating">
                                        <input asp-for="Input.NationalId" class="form-control" />
                                        <label asp-for="Input.NationalId"></label>
                                        <span asp-validation-for="Input.NationalId" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating">
                                        <input asp-for="Input.LicenceNumber" class="form-control" />
                                        <label asp-for="Input.LicenceNumber"></label>
                                        <span asp-validation-for="Input.LicenceNumber" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating">
                                        <input asp-for="Input.Hospital" class="form-control" />
                                        <label asp-for="Input.Hospital"></label>
                                        <span asp-validation-for="Input.Hospital" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="w-100 btn btn-lg" style="background-color: #004085; color: #fff;">Complete Registration</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <script>
        $(document).ready(function () {
            function toggleFields() {
                const role = $("#Input_Role").val();
                if (role === "Student") {
                    $("#studentFields").show();
                    $("#medicalFields").hide();
                    $("#Input_University, #Input_Course, #Input_YearOfStudy").prop("required", true);
                    $("#Input_NationalId, #Input_LicenceNumber").prop("required", false);
                } else if (role === "Therapist" || role === "Psychiatrist") {
                    $("#studentFields").hide();
                    $("#medicalFields").show();
                    $("#Input_University, #Input_Course, #Input_YearOfStudy").prop("required", false);
                    $("#Input_NationalId, #Input_LicenceNumber").prop("required", true);
                } else {
                    $("#studentFields").hide();
                    $("#medicalFields").hide();
                }
            }

            $("#Input_Role").change(toggleFields);
            toggleFields(); // Initial state
        });
    </script>
}